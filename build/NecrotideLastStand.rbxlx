			<Item class="ModuleScript" referent="RBX2">
				<Properties>
					<string name="Name">GameConfig</string>
					<ProtectedString name="Source"><![CDATA[-- GameConfig: every tuning number for NECROTIDE: LAST STAND lives here.
-- Safe to edit in Studio while the game is stopped; nothing else hardcodes balance.

local GameConfig = {}

GameConfig.GameName = "NECROTIDE: LAST STAND"
GameConfig.Tagline = "Hold the Ashvault until the Hollow Choir stops singing."

-- Economy -------------------------------------------------------------------
GameConfig.StartingSalvage = 500
GameConfig.SalvagePerHit = 10
GameConfig.SalvagePerKill = 60
GameConfig.SalvagePerHeadshotKill = 90
GameConfig.SalvagePerBoardRepair = 12
GameConfig.SalvagePerRevive = 150
GameConfig.WaveClearBonus = 100 -- multiplied by the wave number

-- Rounds --------------------------------------------------------------------
GameConfig.IntermissionFirst = 18 -- seconds before wave 1
GameConfig.IntermissionBetween = 14 -- seconds between waves
GameConfig.FinalBossWave = 20
GameConfig.BossWaveInterval = 5 -- a mini-boss spawns every N waves
GameConfig.EndlessAfterVictory = true
GameConfig.MaxAliveEnemies = 26
GameConfig.SpawnInterval = 1.05 -- seconds between spawn attempts
GameConfig.RestartDelay = 12 -- seconds after a squad wipe before the run resets

-- Enemy scaling -------------------------------------------------------------
GameConfig.EnemyBaseCount = 10
GameConfig.EnemyCountPerWave = 5
GameConfig.EnemyCountPerExtraPlayer = 0.45 -- extra fraction of the wave per extra player
GameConfig.EnemyCountCap = 80
GameConfig.HealthLinearPerWave = 0.24 -- +24% of base health per wave, early waves
GameConfig.HealthExponentialWave = 10 -- after this wave health compounds instead
GameConfig.HealthExponentialRate = 1.11
GameConfig.SpeedPerWave = 0.35
GameConfig.MaxEnemySpeed = 21

-- Players -------------------------------------------------------------------
GameConfig.BaseMaxHealth = 100
GameConfig.RegenDelay = 5 -- seconds out of combat before health regenerates
GameConfig.RegenRate = 12 -- health per second
GameConfig.BleedOutTime = 32 -- seconds downed before you are out for the wave
GameConfig.ReviveTime = 3.5 -- seconds of holding the revive prompt

-- Stations ------------------------------------------------------------------
GameConfig.CrateBaseCost = 950
GameConfig.CrateRelocateChance = 0.11 -- chance the Hollow Doll appears and moves the crate
GameConfig.CrateForcedMoveUses = 9 -- guaranteed relocate after this many pulls
GameConfig.CrateSpinTime = 3.6
GameConfig.ForgeCost = 5000
GameConfig.ForgeTime = 4.0
GameConfig.AmmoRefillCostRatio = 0.5 -- wall ammo costs half the weapon price

-- Powerups ------------------------------------------------------------------
GameConfig.PowerupDropChance = 0.035
GameConfig.PowerupLifetime = 22
GameConfig.PowerupMaxPerWave = 4

-- Barriers ------------------------------------------------------------------
GameConfig.BoardsPerBarrier = 5
GameConfig.BoardTearTime = 1.35 -- seconds an enemy needs per board
GameConfig.BoardRepairTime = 0.7 -- prompt hold time per board

-- Misc ----------------------------------------------------------------------
GameConfig.EnemyAttackRange = 6.5
GameConfig.EnemyAttackCooldown = 1.15
GameConfig.MaxWeaponSlots = 2
GameConfig.DebugLogging = false

return GameConfig
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX3">
				<Properties>
					<string name="Name">Net</string>
					<ProtectedString name="Source"><![CDATA[-- Net: creates (server) or waits for (client) the remotes used by the game.
-- Every remote name is declared here so the client -> server surface is auditable
-- in one place.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Net = {}

Net.Events = {
	-- client -> server
	"FireRequest",
	"ReloadRequest",
	"SwapRequest",
	-- server -> client
	"LoadoutChanged",
	"EconomyChanged",
	"WaveChanged",
	"Announce",
	"Notify",
	"Hitmarker",
	"ShotFx",
	"CrateSpin",
	"BossState",
	"DownedState",
	"RunEnded",
	"PowerupFx",
	"TonicsChanged",
}

Net.Functions = {
	"RequestSnapshot",
}

local FOLDER_NAME = "NecrotideRemotes"

local function folder()
	if RunService:IsServer() then
		local existing = ReplicatedStorage:FindFirstChild(FOLDER_NAME)
		if not existing then
			existing = Instance.new("Folder")
			existing.Name = FOLDER_NAME
			existing.Parent = ReplicatedStorage
		end
		return existing
	end
	return ReplicatedStorage:WaitForChild(FOLDER_NAME, 60)
end

-- Server only: build every declared remote up front.
function Net.init()
	local root = folder()
	for _, name in ipairs(Net.Events) do
		if not root:FindFirstChild(name) then
			local remote = Instance.new("RemoteEvent")
			remote.Name = name
			remote.Parent = root
		end
	end
	for _, name in ipairs(Net.Functions) do
		if not root:FindFirstChild(name) then
			local remote = Instance.new("RemoteFunction")
			remote.Name = name
			remote.Parent = root
		end
	end
	return root
end

local cache = {}

function Net.get(name)
	local cached = cache[name]
	if cached and cached.Parent then
		return cached
	end
	local root = folder()
	if not root then
		error("Necrotide: remote folder never replicated")
	end
	local found
	if RunService:IsServer() then
		found = root:FindFirstChild(name)
		if not found then
			error("Necrotide: unknown remote " .. tostring(name))
		end
	else
		found = root:WaitForChild(name, 60)
	end
	cache[name] = found
	return found
end

return Net
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX4">
				<Properties>
					<string name="Name">PowerupDefs</string>
					<ProtectedString name="Source"><![CDATA[-- PowerupDefs: the floating pickups the horde sometimes drops. Team-wide effects.

local PowerupDefs = {}

PowerupDefs.List = {
	{
		id = "purge",
		name = "PURGE PULSE",
		blurb = "The horde is erased",
		weight = 14,
		color = Color3.fromRGB(255, 240, 120),
		duration = 0,
	},
	{
		id = "resupply",
		name = "RESUPPLY CACHE",
		blurb = "Ammo restored",
		weight = 26,
		color = Color3.fromRGB(120, 200, 255),
		duration = 0,
	},
	{
		id = "culling",
		name = "CULLING HOUR",
		blurb = "One touch kills",
		weight = 18,
		color = Color3.fromRGB(255, 90, 90),
		duration = 25,
	},
	{
		id = "surge",
		name = "SALVAGE SURGE",
		blurb = "Double salvage",
		weight = 26,
		color = Color3.fromRGB(150, 255, 150),
		duration = 30,
	},
	{
		id = "mend",
		name = "FIELD MEND",
		blurb = "Squad healed and lifted",
		weight = 16,
		color = Color3.fromRGB(255, 255, 255),
		duration = 0,
	},
}

local byId = {}
for _, def in ipairs(PowerupDefs.List) do
	byId[def.id] = def
end

function PowerupDefs.get(id)
	return byId[id]
end

function PowerupDefs.pool()
	local pool = {}
	for _, def in ipairs(PowerupDefs.List) do
		table.insert(pool, { value = def.id, weight = def.weight })
	end
	return pool
end

return PowerupDefs
]]></ProtectedString>
