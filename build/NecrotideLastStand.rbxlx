			<Item class="ModuleScript" referent="RBX5">
				<Properties>
					<string name="Name">TonicDefs</string>
					<ProtectedString name="Source"><![CDATA[-- TonicDefs: the buyable permanent buffs ("Tonics"), dispensed by Tonic Stills
-- placed around the Ashvault. Original names and effects.

local TonicDefs = {}

TonicDefs.List = {
	{
		id = "ironhide",
		name = "Ironhide Draught",
		blurb = "+120 max vitality",
		cost = 2500,
		color = Color3.fromRGB(220, 80, 60),
		effects = { bonusHealth = 120 },
	},
	{
		id = "quickhands",
		name = "Quickhands Tincture",
		blurb = "Reload 55% faster",
		cost = 2000,
		color = Color3.fromRGB(240, 200, 70),
		effects = { reloadScale = 0.45 },
	},
	{
		id = "deadeye",
		name = "Deadeye Elixir",
		blurb = "+25% weapon damage",
		cost = 3000,
		color = Color3.fromRGB(120, 200, 255),
		effects = { damageMult = 1.25 },
	},
	{
		id = "fleetfoot",
		name = "Fleetfoot Serum",
		blurb = "+22% sprint speed",
		cost = 1800,
		color = Color3.fromRGB(120, 240, 160),
		effects = { speedMult = 1.22 },
	},
	{
		id = "scavenger",
		name = "Scavenger Brew",
		blurb = "+35% salvage earned",
		cost = 2200,
		color = Color3.fromRGB(190, 140, 255),
		effects = { salvageMult = 1.35 },
	},
	{
		id = "secondwind",
		name = "Second Wind Phial",
		blurb = "Revive yourself once per wave",
		cost = 3500,
		color = Color3.fromRGB(255, 255, 255),
		effects = { selfRevive = true },
	},
}

local byId = {}
for _, def in ipairs(TonicDefs.List) do
	byId[def.id] = def
end

function TonicDefs.get(id)
	return byId[id]
end

-- Collapses a player's owned tonic ids into one multiplier table.
function TonicDefs.aggregate(owned)
	local agg = {
		bonusHealth = 0,
		reloadScale = 1,
		damageMult = 1,
		speedMult = 1,
		salvageMult = 1,
		selfRevive = false,
	}
	for id, has in pairs(owned or {}) do
		local def = has and byId[id]
		if def then
			local e = def.effects
			agg.bonusHealth = agg.bonusHealth + (e.bonusHealth or 0)
			agg.reloadScale = agg.reloadScale * (e.reloadScale or 1)
			agg.damageMult = agg.damageMult * (e.damageMult or 1)
			agg.speedMult = agg.speedMult * (e.speedMult or 1)
			agg.salvageMult = agg.salvageMult * (e.salvageMult or 1)
			if e.selfRevive then
				agg.selfRevive = true
			end
		end
	end
	return agg
end

return TonicDefs
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX6">
				<Properties>
					<string name="Name">Util</string>
					<ProtectedString name="Source"><![CDATA[-- Util: tiny shared helpers. No state, safe to require from client or server.

local Players = game:GetService("Players")

local Util = {}

function Util.clamp(n, lo, hi)
	if n < lo then return lo end
	if n > hi then return hi end
	return n
end

function Util.lerp(a, b, t)
	return a + (b - a) * t
end

-- Comma-separates a number for HUD display: 12400 -> "12,400"
function Util.comma(n)
	local s = tostring(math.floor(n))
	local out = ""
	local count = 0
	for i = #s, 1, -1 do
		out = s:sub(i, i) .. out
		count = count + 1
		if count % 3 == 0 and i > 1 then
			out = "," .. out
		end
	end
	return out
end

function Util.formatTime(seconds)
	local s = math.max(0, math.floor(seconds))
	return string.format("%d:%02d", math.floor(s / 60), s % 60)
end

-- Weighted pick from { {value = x, weight = n}, ... }
function Util.weightedPick(entries, rng)
	local total = 0
	for _, entry in ipairs(entries) do
		total = total + (entry.weight or 1)
	end
	if total <= 0 then return nil end
	local roll = (rng and rng:NextNumber() or math.random()) * total
	local acc = 0
	for _, entry in ipairs(entries) do
		acc = acc + (entry.weight or 1)
		if roll <= acc then
			return entry.value
		end
	end
	return entries[#entries].value
end

function Util.shallowCopy(tbl)
	local out = {}
	for k, v in pairs(tbl) do
		out[k] = v
	end
	return out
end

function Util.deepCopy(tbl)
	local out = {}
	for k, v in pairs(tbl) do
		if type(v) == "table" then
			out[k] = Util.deepCopy(v)
		else
			out[k] = v
		end
	end
	return out
end

function Util.randomFlatOffset(radius)
	local angle = math.random() * math.pi * 2
	local dist = math.sqrt(math.random()) * radius
	return Vector3.new(math.cos(angle) * dist, 0, math.sin(angle) * dist)
end

-- Every player who is alive, standing and targetable by the horde.
function Util.activeTargets()
	local out = {}
	for _, player in ipairs(Players:GetPlayers()) do
		local character = player.Character
		if character then
			local root = character.PrimaryPart or character:FindFirstChild("HumanoidRootPart")
			local humanoid = character:FindFirstChildOfClass("Humanoid")
			if root and humanoid and humanoid.Health > 0 and player:GetAttribute("Downed") ~= true then
				table.insert(out, {
					player = player,
					character = character,
					root = root,
					humanoid = humanoid,
				})
			end
		end
	end
	return out
end

-- Downed players still exist as targets of last resort so enemies do not idle.
function Util.anyLivingCharacters()
	local out = {}
	for _, player in ipairs(Players:GetPlayers()) do
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local root = character and (character.PrimaryPart or character:FindFirstChild("HumanoidRootPart"))
		if humanoid and root and humanoid.Health > 0 then
			table.insert(out, { player = player, character = character, root = root, humanoid = humanoid })
		end
	end
	return out
end

return Util
]]></ProtectedString>
				</Properties>
