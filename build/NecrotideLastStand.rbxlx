		colors = {
			torso = Color3.fromRGB(58, 44, 92),
			head = Color3.fromRGB(96, 74, 150),
			limb = Color3.fromRGB(44, 34, 72),
			glow = Color3.fromRGB(190, 130, 255),
		},
		abilities = {
			{ kind = "shockwave", cooldown = 8, radius = 30, damage = 40 },
