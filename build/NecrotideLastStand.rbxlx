	<Item class="ServerScriptService" referent="RBX22">
		<Properties>
			<string name="Name">ServerScriptService</string>
		</Properties>
		<Item class="Script" referent="RBX10">
			<Properties>
				<string name="Name">Bootstrap</string>
				<ProtectedString name="Source"><![CDATA[-- Bootstrap: the only Script in the place. It builds the arena, wires every
-- service together through one shared registry table and starts the round loop.
--
-- Services get `init(registry)` called in dependency order and talk to each other
-- through `S.OtherService`, which keeps requires acyclic.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("NecrotideShared")
local GameConfig = require(Shared.GameConfig)
local Net = require(Shared.Net)

local ServicesFolder = script.Parent:WaitForChild("Services")

Net.init()

-- PlayerService owns respawning: a player who bleeds out stays out until the
-- next wave starts, which Roblox's automatic respawn would otherwise undo.
Players.CharacterAutoLoads = false

local S = {}

local ORDER = {
	"Economy",
	"PlayerService",
	"Loadout",
	"Combat",
	"EnemyService",
	"BarrierService",
	"StationService",
	"PowerupService",
	"WaveService",
}

-- map first: every service reads S.Map
local MapBuilder = require(ServicesFolder:WaitForChild("MapBuilder"))
S.MapBuilder = MapBuilder
S.Map = MapBuilder.build()

for _, name in ipairs(ORDER) do
	S[name] = require(ServicesFolder:WaitForChild(name))
end

for _, name in ipairs(ORDER) do
	local service = S[name]
	if type(service.init) == "function" then
		local ok, err = pcall(service.init, S)
		if not ok then
			warn("[Necrotide] " .. name .. " failed to init: " .. tostring(err))
		end
	end
end

-- One round trip that gives a joining or respawning client its whole world state.
Net.get("RequestSnapshot").OnServerInvoke = function(player)
	local boss = S.EnemyService.boss()
	return {
		config = {
			gameName = GameConfig.GameName,
			tagline = GameConfig.Tagline,
			finalWave = GameConfig.FinalBossWave,
			crateCost = GameConfig.CrateBaseCost,
			forgeCost = GameConfig.ForgeCost,
			reviveTime = GameConfig.ReviveTime,
		},
		wave = S.WaveService.snapshot(),
		economy = S.Economy.snapshot(player),
		loadout = S.Loadout.snapshot(player),
		player = S.PlayerService.snapshot(player),
		boss = boss and {
			active = true,
			name = boss.def.name,
			title = boss.def.title,
			health = boss.health,
			maxHealth = boss.maxHealth,
			final = boss.def.isFinal == true,
		} or { active = false },
	}
end

S.WaveService.start()

print(string.format("[%s] Ashvault online. Final boss at wave %d.", GameConfig.GameName, GameConfig.FinalBossWave))
]]></ProtectedString>
				<bool name="Disabled">false</bool>
			</Properties>
		</Item>
		<Item class="Folder" referent="RBX21">
			<Properties>
				<string name="Name">Services</string>
			</Properties>
			<Item class="ModuleScript" referent="RBX11">
				<Properties>
					<string name="Name">BarrierService</string>
					<ProtectedString name="Source"><![CDATA[-- BarrierService: the boarded gaps in the perimeter wall. Enemies claw the boards
-- off one at a time to get in; players hold E to nail them back on for salvage.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("NecrotideShared")
local GameConfig = require(Shared.GameConfig)
local Net = require(Shared.Net)

local BarrierService = {}
local S

local function boardState(barrier)
	if not barrier.state then
		barrier.state = {
			intact = {},
			tearProgress = 0,
			repairing = false,
		}
		for index, board in ipairs(barrier.boards) do
			barrier.state.intact[index] = true
			board:SetAttribute("HomePos", board.Position)
			board:SetAttribute("HomeSize", board.Size)
		end
	end
	return barrier.state
end

local function intactCount(barrier)
	local state = boardState(barrier)
	local count = 0
	for _, isIntact in pairs(state.intact) do
		if isIntact then count = count + 1 end
	end
	return count
end

local function setBoardVisible(board, visible)
	if visible then
		board.Transparency = 0
		board.CanCollide = true
	else
		board.Transparency = 1
		board.CanCollide = false
	end
end

local function updatePrompt(barrier)
	local prompt = barrier.prompt
	if not prompt then return end
	local missing = #barrier.boards - intactCount(barrier)
	prompt.Enabled = missing > 0
	prompt.ObjectText = "BARRICADE  " .. intactCount(barrier) .. "/" .. #barrier.boards
end

function BarrierService.isOpen(barrier)
	return intactCount(barrier) == 0
end

-- Rips a board loose. Called every tick by every enemy pressed against the gap,
-- so the progress from the first caller in a tick counts in full and everyone
-- else only adds a small crowd bonus. Without this, ten husks at one window
-- would strip five boards in well under a second.
local CROWD_BONUS = 0.15

function BarrierService.tear(barrier, dt, entity)
	local state = boardState(barrier)
	local now = os.clock()
	if state.lastTearAt and now - state.lastTearAt < 0.02 then
		state.tearProgress = state.tearProgress + dt * CROWD_BONUS
	else
		state.lastTearAt = now
		state.tearProgress = state.tearProgress + dt
	end
	local tearTime = GameConfig.BoardTearTime
	if state.tearProgress < tearTime then
		-- rattle the topmost intact board so the players can see it going
		for index = #barrier.boards, 1, -1 do
			if state.intact[index] then
				local board = barrier.boards[index]
				local home = board:GetAttribute("HomePos")
				if home then
					local jitter = Vector3.new((math.random() - 0.5) * 0.5, (math.random() - 0.5) * 0.3, (math.random() - 0.5) * 0.5)
					board.Position = home + jitter
				end
				break
			end
		end
		return false
	end

	state.tearProgress = 0
	for index = #barrier.boards, 1, -1 do
		if state.intact[index] then
			state.intact[index] = false
			local board = barrier.boards[index]
			setBoardVisible(board, false)

			-- a loose plank spins away from the gap
			local debris = board:Clone()
			debris.Name = "LoosePlank"
			debris.Transparency = 0
			debris.CanCollide = false
			debris.Anchored = false
			debris.Parent = S.Map.fxFolder
			debris.AssemblyLinearVelocity = barrier.inward * 22 + Vector3.new(0, 14, 0)
			debris.AssemblyAngularVelocity = Vector3.new(math.random() * 12, math.random() * 12, math.random() * 12)
			game:GetService("Debris"):AddItem(debris, 4)
			break
		end
	end
	updatePrompt(barrier)
	return intactCount(barrier) == 0
end

-- Bosses do not bother with carpentry.
function BarrierService.smash(barrier)
	local state = boardState(barrier)
	for index, board in ipairs(barrier.boards) do
		if state.intact[index] then
			state.intact[index] = false
			setBoardVisible(board, false)
		end
	end
	state.tearProgress = 0
	updatePrompt(barrier)
end

function BarrierService.repairOne(barrier, player)
	local state = boardState(barrier)
	for index, board in ipairs(barrier.boards) do
		if not state.intact[index] then
			state.intact[index] = true
			local home = board:GetAttribute("HomePos")
			if home then
				board.Position = home
			end
			setBoardVisible(board, true)
			local homeSize = board:GetAttribute("HomeSize") or board.Size
			board.Size = homeSize * 0.6
			TweenService:Create(board, TweenInfo.new(0.18, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
				Size = homeSize,
			}):Play()
			updatePrompt(barrier)
			if player then
				local gained = S.Economy.add(player, GameConfig.SalvagePerBoardRepair)
				Net.get("Notify"):FireClient(player, {
					text = "Board replaced  +" .. gained,
					color = { 200, 170, 120 },
				})
			end
			return true
		end
	end
	return false
end

function BarrierService.resetAll()
	for _, barrier in ipairs(S.Map.barriers) do
		local state = boardState(barrier)
		state.tearProgress = 0
		for index, board in ipairs(barrier.boards) do
			state.intact[index] = true
			local home = board:GetAttribute("HomePos")
			if home then
				board.Position = home
			end
			setBoardVisible(board, true)
		end
		updatePrompt(barrier)
	end
end

function BarrierService.init(services)
	S = services
	for _, barrier in ipairs(S.Map.barriers) do
		boardState(barrier)

		local prompt = Instance.new("ProximityPrompt")
		prompt.Name = "RepairPrompt"
		prompt.ActionText = "Repair Barricade"
		prompt.ObjectText = "BARRICADE"
		prompt.HoldDuration = GameConfig.BoardRepairTime
		prompt.MaxActivationDistance = 12
		prompt.RequiresLineOfSight = false
		prompt.KeyboardKeyCode = Enum.KeyCode.E
		prompt.Enabled = false
		prompt.Parent = barrier.promptAnchor
		barrier.prompt = prompt

		prompt.Triggered:Connect(function(player)
			if S.PlayerService.isDowned(player) or S.PlayerService.isOut(player) then return end
			BarrierService.repairOne(barrier, player)
		end)

		updatePrompt(barrier)
	end
end

return BarrierService
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX12">
				<Properties>
					<string name="Name">Combat</string>
					<ProtectedString name="Source"><![CDATA[-- Combat: server-authoritative hitscan. The client sends only an aim direction;
-- the server owns the origin, the spread roll, the raycast, the damage and the
-- ammo. Explosives, chain lightning and piercing all resolve here too.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Debris = game:GetService("Debris")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("NecrotideShared")
local GameConfig = require(Shared.GameConfig)
local Net = require(Shared.Net)

local Combat = {}
local S

local MAX_ORIGIN_DRIFT = 14 -- studs the claimed origin may differ from the head
local rng = Random.new(os.clock() * 7919)

local function shootParams(character)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.IgnoreWater = true
	local filter = { character }
	if S.Map then
		table.insert(filter, S.Map.fxFolder)
	end
	params.FilterDescendantsInstances = filter
	return params
end

local function applySpread(direction, spreadDegrees)
	if spreadDegrees <= 0 then return direction end
	local spread = math.rad(spreadDegrees)
	local up = math.abs(direction.Y) > 0.99 and Vector3.new(1, 0, 0) or Vector3.new(0, 1, 0)
	local right = direction:Cross(up).Unit
	local trueUp = right:Cross(direction).Unit
	local angle = rng:NextNumber(0, math.pi * 2)
	local magnitude = math.sqrt(rng:NextNumber()) * spread
	local offset = (right * math.cos(angle) + trueUp * math.sin(angle)) * math.tan(magnitude)
	return (direction + offset).Unit
end

local function explode(center, radius, damage, attacker, color)
	local ring = Instance.new("Part")
	ring.Shape = Enum.PartType.Ball
	ring.Size = Vector3.new(4, 4, 4)
	ring.Position = center
	ring.Anchored = true
	ring.CanCollide = false
	ring.Material = Enum.Material.Neon
	ring.Color = color or Color3.fromRGB(255, 150, 60)
	ring.Transparency = 0.15
	ring.Parent = S.Map.fxFolder
	TweenService:Create(ring, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = Vector3.new(radius * 2, radius * 2, radius * 2),
		Transparency = 1,
	}):Play()
	Debris:AddItem(ring, 0.8)

	local hits = 0
	S.EnemyService.forEach(function(entity)
		local delta = entity.root.Position - center
		if delta.Magnitude <= radius then
			local falloff = 1 - (delta.Magnitude / radius) * 0.5
			S.EnemyService.damage(entity, damage * falloff, attacker, false)
			hits = hits + 1
		end
	end)
	return hits
end

local function chainFrom(entity, inst, attacker, chainDef, alreadyHit)
	local origin = entity.root.Position
	local remaining = chainDef.count or 3
	local damage = inst.damage * (chainDef.mult or 0.6)
	local links = {}
	local current = origin

	while remaining > 0 do
		local best, bestDist
		S.EnemyService.forEach(function(candidate)
			if alreadyHit[candidate.uid] then return end
			local dist = (candidate.root.Position - current).Magnitude
			if dist <= (chainDef.radius or 20) and (not bestDist or dist < bestDist) then
				best, bestDist = candidate, dist
			end
		end)
		if not best then break end
		alreadyHit[best.uid] = true
		table.insert(links, best.root.Position)
		S.EnemyService.damage(best, damage, attacker, false)
		current = best.root.Position
		damage = damage * (chainDef.mult or 0.6)
		remaining = remaining - 1
	end
	return links
end

local function resolveShot(player, direction)
	local character = player.Character
	if not character then return end
	local head = character:FindFirstChild("Head") or character.PrimaryPart
	if not head then return end

	local inst = S.Loadout.consumeShot(player)
	if not inst then return end

	local origin = head.Position
	local damageMult = S.PlayerService.tonicAgg(player).damageMult
	local params = shootParams(character)
	local pellets = math.max(1, inst.pellets or 1)
	local endPoints = {}
	local chainLinks = nil
	-- a shotgun blast is one hitmarker, not eight, so feedback is aggregated
	local feedback = { hit = false, headshot = false, killed = false, boss = false }

	for _ = 1, pellets do
		local dir = applySpread(direction, inst.spread)
		local remainingPierce = inst.pierce or 0
		local rayOrigin = origin
		local rayParams = params
		-- piercing rounds accumulate exclusions so they never re-hit a target
		local pierceFilter = { character, S.Map.fxFolder }
		local hitThisPellet = {}
		local travelled = 0
		local landed = origin + dir * inst.range

		while true do
			local remainingRange = inst.range - travelled
			if remainingRange <= 0 then break end
			local result = workspace:Raycast(rayOrigin, dir * remainingRange, rayParams)
			if not result then
				landed = rayOrigin + dir * remainingRange
				break
			end
			landed = result.Position
			local entity = S.EnemyService.entityFromPart(result.Instance)
			if entity then
				local isHead = result.Instance.Name == "Head"
				local damage = inst.damage * damageMult * (isHead and inst.headMult or 1)
				local before = entity.health
				S.EnemyService.damage(entity, damage, player, isHead)
				hitThisPellet[entity.uid] = true

				if before > 0 and entity.health > 0 then
					S.Economy.add(player, GameConfig.SalvagePerHit)
				end
				feedback.hit = true
				feedback.headshot = feedback.headshot or isHead
				feedback.killed = feedback.killed or entity.health <= 0
				feedback.boss = feedback.boss or entity.isBoss

				if inst.chain then
					chainLinks = chainFrom(entity, inst, player, inst.chain, hitThisPellet)
				end

				if remainingPierce > 0 then
					remainingPierce = remainingPierce - 1
					travelled = travelled + (result.Position - rayOrigin).Magnitude + 0.5
					rayOrigin = result.Position + dir * 0.5
					if entity.model then
						table.insert(pierceFilter, entity.model)
					end
					local nextParams = RaycastParams.new()
					nextParams.FilterType = Enum.RaycastFilterType.Exclude
					nextParams.IgnoreWater = true
					nextParams.FilterDescendantsInstances = pierceFilter
					rayParams = nextParams
				else
					break
				end
			else
				break
			end
		end

		if inst.explosive then
			explode(landed, inst.explosive.radius, inst.explosive.damage * damageMult, player, inst.tracerColor)
		end
		table.insert(endPoints, landed)
	end

	if feedback.hit then
		Net.get("Hitmarker"):FireClient(player, feedback)
	end

	Net.get("ShotFx"):FireAllClients({
		shooter = player,
		points = endPoints,
		color = inst.tracerColor and { inst.tracerColor.R * 255, inst.tracerColor.G * 255, inst.tracerColor.B * 255 } or nil,
		chain = chainLinks,
		upgraded = inst.upgraded,
		class = inst.class,
	})
end

function Combat.init(services)
	S = services

	Net.get("FireRequest").OnServerEvent:Connect(function(player, direction, claimedOrigin)
		if typeof(direction) ~= "Vector3" then return end
		if direction.Magnitude < 0.01 or direction.Magnitude > 1000 then return end
		local character = player.Character
		local head = character and (character:FindFirstChild("Head") or character.PrimaryPart)
		if not head then return end
		if typeof(claimedOrigin) == "Vector3" then
			-- the claimed origin is only ever used as a sanity check; the shot
			-- always starts from the server's copy of the player's head
			if (claimedOrigin - head.Position).Magnitude > MAX_ORIGIN_DRIFT then
				return
			end
		end
		local ok, err = pcall(resolveShot, player, direction.Unit)
		if not ok and GameConfig.DebugLogging then
			warn("[Necrotide] shot failed: " .. tostring(err))
		end
	end)
end

return Combat
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX13">
				<Properties>
					<string name="Name">Economy</string>
					<ProtectedString name="Source"><![CDATA[-- Economy: salvage (the currency), kill counters and leaderstats.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("NecrotideShared")
local GameConfig = require(Shared.GameConfig)
local Net = require(Shared.Net)

local Economy = {}
local S

local state = {}
local globalSalvageMult = 1

local function ensure(player)
	local entry = state[player]
	if not entry then
		entry = { salvage = GameConfig.StartingSalvage, kills = 0, spent = 0 }
		state[player] = entry
	end
	return entry
end

local function push(player)
	local entry = ensure(player)
	local stats = player:FindFirstChild("leaderstats")
	if stats then
		local salvage = stats:FindFirstChild("Salvage")
		local kills = stats:FindFirstChild("Kills")
		if salvage then salvage.Value = entry.salvage end
		if kills then kills.Value = entry.kills end
	end
	Net.get("EconomyChanged"):FireClient(player, {
		salvage = entry.salvage,
		kills = entry.kills,
	})
end

function Economy.init(services)
	S = services

	local function setup(player)
		ensure(player)
		local stats = player:FindFirstChild("leaderstats")
		if not stats then
			stats = Instance.new("Folder")
			stats.Name = "leaderstats"
			stats.Parent = player
		end
		if not stats:FindFirstChild("Salvage") then
			local v = Instance.new("IntValue")
			v.Name = "Salvage"
			v.Value = state[player].salvage
			v.Parent = stats
		end
		if not stats:FindFirstChild("Kills") then
			local v = Instance.new("IntValue")
			v.Name = "Kills"
			v.Value = 0
			v.Parent = stats
		end
		push(player)
	end

	for _, player in ipairs(Players:GetPlayers()) do
		setup(player)
	end
	Players.PlayerAdded:Connect(setup)
	Players.PlayerRemoving:Connect(function(player)
		state[player] = nil
	end)
end

function Economy.get(player)
	return ensure(player).salvage
end

function Economy.setGlobalMultiplier(mult)
	globalSalvageMult = mult
end

-- `raw = true` skips tonic/powerup multipliers (used for refunds and bonuses).
function Economy.add(player, amount, raw)
	if not player or not player.Parent then return 0 end
	local entry = ensure(player)
	local final = amount
	if not raw then
		local mult = globalSalvageMult
		if S and S.PlayerService then
			mult = mult * S.PlayerService.tonicAgg(player).salvageMult
		end
		final = math.floor(amount * mult)
	end
	entry.salvage = math.max(0, entry.salvage + final)
	push(player)
	return final
end

function Economy.canAfford(player, cost)
	return ensure(player).salvage >= cost
end

function Economy.spend(player, cost)
	local entry = ensure(player)
	if entry.salvage < cost then
		return false
	end
	entry.salvage = entry.salvage - cost
	entry.spent = entry.spent + cost
	push(player)
	return true
end

function Economy.addKill(player)
	local entry = ensure(player)
	entry.kills = entry.kills + 1
	push(player)
end

function Economy.resetAll()
	for player, entry in pairs(state) do
		entry.salvage = GameConfig.StartingSalvage
		entry.kills = 0
		entry.spent = 0
		push(player)
	end
	globalSalvageMult = 1
end

function Economy.snapshot(player)
	local entry = ensure(player)
	return { salvage = entry.salvage, kills = entry.kills }
end

return Economy
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX14">
				<Properties>
					<string name="Name">EnemyService</string>
					<ProtectedString name="Source"><![CDATA[-- EnemyService: spawns, animates, steers and kills every creature in the game.
--
-- Enemies are lightweight: each one is a small anchored Model that is moved with
-- Model:PivotTo on a fixed 20 Hz tick. That keeps dozens of them cheap and, more
-- importantly, keeps them perfectly predictable - no rigs, no physics fights, no
-- Humanoid pathing quirks. Steering walks straight at the target when there is a
-- clear line, and falls back to PathfindingService around walls.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local PathfindingService = game:GetService("PathfindingService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local Shared = ReplicatedStorage:WaitForChild("NecrotideShared")
local GameConfig = require(Shared.GameConfig)
local EnemyDefs = require(Shared.EnemyDefs)
local Util = require(Shared.Util)
local Net = require(Shared.Net)

local EnemyService = {}
local S

local TICK_RATE = 1 / 20

local entities = {}
local aliveCount = 0
local boss = nil
local instakill = false
local nextId = 0
local accumulator = 0
local heartbeatConn
local rng = Random.new(os.clock() * 1000)

--------------------------------------------------------------------------------
-- construction
--------------------------------------------------------------------------------

local function makePart(name, size, color, material, parent)
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.Color = color
	part.Material = material or Enum.Material.SmoothPlastic
	part.Anchored = true
	part.CanCollide = false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = parent
	return part
end

local function buildModel(def, position)
	local h = def.height
	local w = def.width
	local colors = def.colors

	local model = Instance.new("Model")
	model.Name = "Necro_" .. def.id

	local torsoHeight = h * 0.42
	local torso = makePart("Torso", Vector3.new(w, torsoHeight, w * 0.62), colors.torso, Enum.Material.Fabric, model)
	torso.CanCollide = true
	torso.Position = position + Vector3.new(0, h * 0.5, 0)

	local headSize = w * 0.62
	local head = makePart("Head", Vector3.new(headSize, headSize, headSize), colors.head, Enum.Material.SmoothPlastic, model)
	head.Position = torso.Position + Vector3.new(0, torsoHeight * 0.5 + headSize * 0.5, 0)

	local eyeSize = math.max(0.16, headSize * 0.16)
	for _, side in ipairs({ -1, 1 }) do
		local eye = makePart("Eye", Vector3.new(eyeSize, eyeSize, eyeSize), colors.glow, Enum.Material.Neon, model)
		eye.Position = head.Position + Vector3.new(side * headSize * 0.24, headSize * 0.1, -headSize * 0.52)
		local light = Instance.new("PointLight")
		light.Color = colors.glow
		light.Brightness = def.isBoss and 3 or 0.8
		light.Range = def.isBoss and 30 or 10
		light.Parent = eye
	end

	local armLength = h * 0.34
	for _, side in ipairs({ -1, 1 }) do
		local arm = makePart("Arm", Vector3.new(w * 0.24, armLength, w * 0.24), colors.limb, Enum.Material.Fabric, model)
		-- arms held forward, classic shambling reach
		arm.CFrame = CFrame.new(torso.Position + Vector3.new(side * (w * 0.55), torsoHeight * 0.1, -armLength * 0.42))
			* CFrame.Angles(math.rad(-72), 0, 0)
	end

	local legLength = h * 0.34
	for _, side in ipairs({ -1, 1 }) do
		local leg = makePart("Leg", Vector3.new(w * 0.3, legLength, w * 0.3), colors.limb, Enum.Material.Fabric, model)
		leg.Position = torso.Position + Vector3.new(side * (w * 0.22), -(torsoHeight * 0.5 + legLength * 0.5), 0)
	end

	if def.isBoss then
		-- a crown of spikes so bosses read instantly at distance
		for i = 1, 6 do
			local angle = (i / 6) * math.pi * 2
			local spike = makePart("Spike", Vector3.new(w * 0.14, h * 0.22, w * 0.14), colors.glow, Enum.Material.Neon, model)
			spike.CFrame = CFrame.new(head.Position + Vector3.new(math.cos(angle) * headSize * 0.5, headSize * 0.6, math.sin(angle) * headSize * 0.5))
				* CFrame.Angles(math.rad(math.cos(angle) * 22), 0, math.rad(math.sin(angle) * 22))
		end
		local aura = Instance.new("PointLight")
		aura.Color = colors.glow
		aura.Brightness = 5
		aura.Range = 60
		aura.Parent = torso
	end

	model.PrimaryPart = torso
	return model, torso, head
end

local function buildBossBar(entity)
	local gui = Instance.new("BillboardGui")
	gui.Name = "BossBar"
	gui.Size = UDim2.new(16, 0, 1.6, 0)
	gui.StudsOffsetWorldSpace = Vector3.new(0, entity.def.height * 0.65, 0)
	gui.AlwaysOnTop = true
	gui.MaxDistance = 600
	gui.Parent = entity.root

	local back = Instance.new("Frame")
	back.Size = UDim2.fromScale(1, 1)
	back.BackgroundColor3 = Color3.fromRGB(16, 12, 14)
	back.BorderSizePixel = 0
	back.Parent = gui

	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.fromScale(1, 1)
	fill.BackgroundColor3 = entity.def.colors.glow
	fill.BorderSizePixel = 0
	fill.Parent = back

	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBlack
	label.TextScaled = true
	label.TextColor3 = Color3.new(1, 1, 1)
	label.Text = entity.def.name
	label.Parent = back

	entity.bossFill = fill
end

--------------------------------------------------------------------------------
-- scaling
--------------------------------------------------------------------------------

function EnemyService.scaledHealth(base, wave, playerCount)
	local health
	local pivot = GameConfig.HealthExponentialWave
	if wave <= pivot then
		health = base * (1 + GameConfig.HealthLinearPerWave * (wave - 1))
	else
		health = base
			* (1 + GameConfig.HealthLinearPerWave * (pivot - 1))
			* math.pow(GameConfig.HealthExponentialRate, wave - pivot)
	end
	return math.floor(health * (1 + 0.15 * math.max(0, playerCount - 1)))
end

local function scaledSpeed(base, wave)
	return math.min(GameConfig.MaxEnemySpeed, base + GameConfig.SpeedPerWave * (wave - 1))
end

--------------------------------------------------------------------------------
-- spawning
--------------------------------------------------------------------------------

local function abilityState(abilities)
	local out = {}
	for _, ability in ipairs(abilities or {}) do
		table.insert(out, {
			def = ability,
			nextUse = os.clock() + rng:NextNumber(1.5, ability.cooldown),
		})
	end
	return out
end

-- options: { barrier = barrierTable, insideAlready = bool, healthMult = n, isSummon = bool }
function EnemyService.spawn(defId, wave, position, options)
	options = options or {}
	local def = EnemyDefs.get(defId)
	if not def then return nil end
	local map = S.Map
	if not map then return nil end

	local playerCount = math.max(1, #Players:GetPlayers())
	local model, root, head = buildModel(def, position)
	model.Parent = map.enemyFolder

	nextId = nextId + 1
	local maxHealth = EnemyService.scaledHealth(def.health, wave, playerCount)
	if def.isBoss then
		-- bosses lean much harder on squad size and keep climbing in endless mode
		maxHealth = math.floor(def.health * (1 + 0.6 * (playerCount - 1)) * (1 + 0.08 * math.max(0, wave - GameConfig.BossWaveInterval)))
	end
	maxHealth = math.floor(maxHealth * (options.healthMult or 1))

	local entity = {
		uid = nextId,
		def = def,
		model = model,
		root = root,
		head = head,
		health = maxHealth,
		maxHealth = maxHealth,
		speed = def.isBoss and def.speed or scaledSpeed(def.speed, wave),
		damage = def.isBoss and def.damage or math.floor(def.damage * (1 + 0.04 * (wave - 1))),
		wave = wave,
		isBoss = def.isBoss == true,
		y = position.Y + def.height * 0.5,
		lastAttack = 0,
		abilities = abilityState(def.abilities),
		phaseIndex = 0,
		barrier = options.barrier,
		entered = options.insideAlready == true or options.barrier == nil,
		bob = rng:NextNumber(0, math.pi * 2),
		pathAt = 0,
		path = nil,
		pathIndex = 1,
		pathPending = false,
		target = nil,
		retargetAt = 0,
		chargeUntil = 0,
		stunUntil = 0,
		alive = true,
	}

	root:SetAttribute("NecroEnemy", entity.uid)
	root:SetAttribute("MaxHealth", maxHealth)
	root:SetAttribute("Health", maxHealth)
	if head then
		head:SetAttribute("NecroEnemy", entity.uid)
	end

	entities[entity.uid] = entity
	aliveCount = aliveCount + 1

	if entity.isBoss then
		boss = entity
		buildBossBar(entity)
		Net.get("BossState"):FireAllClients({
			active = true,
			name = def.name,
			title = def.title,
			health = entity.health,
			maxHealth = entity.maxHealth,
			final = def.isFinal == true,
		})
	end

	return entity
end

function EnemyService.aliveCount()
	return aliveCount
end

function EnemyService.boss()
	return boss
end

function EnemyService.setInstakill(value)
	instakill = value
end

function EnemyService.entityFromPart(part)
	if not part then return nil end
	local uid = part:GetAttribute("NecroEnemy")
	if not uid then
		local parent = part.Parent
		uid = parent and parent:IsA("Model") and parent.PrimaryPart and parent.PrimaryPart:GetAttribute("NecroEnemy")
	end
	if not uid then return nil end
	return entities[uid]
end

function EnemyService.forEach(fn)
	for _, entity in pairs(entities) do
		if entity.alive then
			fn(entity)
		end
	end
end

--------------------------------------------------------------------------------
-- death
--------------------------------------------------------------------------------

local function ashBurst(entity)
	local root = entity.root
	if not root then return end
	local burst = Instance.new("Part")
	burst.Size = Vector3.new(1, 1, 1)
	burst.Position = root.Position
	burst.Anchored = true
	burst.CanCollide = false
	burst.Transparency = 1
	burst.Parent = S.Map.fxFolder

	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture = "rbxasset://textures/particles/smoke_main.dds"
	emitter.Color = ColorSequence.new(entity.def.colors.torso, entity.def.colors.glow)
	emitter.Lifetime = NumberRange.new(0.4, 0.9)
	emitter.Rate = 0
	emitter.Speed = NumberRange.new(6, 16)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Size = NumberSequence.new(entity.def.width * 0.8)
	emitter.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.2),
		NumberSequenceKeypoint.new(1, 1),
	})
	emitter.Parent = burst
	emitter:Emit(entity.isBoss and 160 or 26)
	Debris:AddItem(burst, 2)
end

local function despawn(entity)
	if not entity.alive then return end
	entity.alive = false
	entities[entity.uid] = nil
	aliveCount = math.max(0, aliveCount - 1)
	if entity.model then
		entity.model:Destroy()
	end
	if entity == boss then
		boss = nil
		Net.get("BossState"):FireAllClients({ active = false })
	end
	if S.WaveService then
		S.WaveService.onEnemyRemoved(entity)
	end
end

local function killEntity(entity, killer, headshot)
	if not entity.alive then return end
	ashBurst(entity)

	if killer and killer.Parent then
		local reward = entity.def.salvage
		if not reward then
			reward = headshot and GameConfig.SalvagePerHeadshotKill or GameConfig.SalvagePerKill
		end
		S.Economy.add(killer, reward)
		S.Economy.addKill(killer)
		Net.get("Hitmarker"):FireClient(killer, { kill = true, boss = entity.isBoss, headshot = headshot })
	end

	if not entity.isBoss and S.PowerupService then
		S.PowerupService.maybeDrop(entity.root.Position)
	end

	despawn(entity)
end

function EnemyService.damage(entity, amount, attacker, headshot)
	if not entity or not entity.alive then return 0 end
	if instakill and not entity.isBoss then
		amount = entity.health
	end
	local dealt = math.min(entity.health, amount)
	entity.health = entity.health - dealt
	if entity.root then
		entity.root:SetAttribute("Health", math.max(0, entity.health))
	end

	if entity.isBoss then
		local fraction = math.max(0, entity.health / entity.maxHealth)
		if entity.bossFill then
			entity.bossFill.Size = UDim2.fromScale(fraction, 1)
		end
		-- the in-world nameplate above updates every hit; the screen-wide bar is
		-- a broadcast, so throttle it to ~10 Hz (and always send the killing blow)
		local now = os.clock()
		if entity.health <= 0 or not entity.bossPushAt or now - entity.bossPushAt >= 0.1 then
			entity.bossPushAt = now
			Net.get("BossState"):FireAllClients({
				active = true,
				name = entity.def.name,
				title = entity.def.title,
				health = math.max(0, entity.health),
				maxHealth = entity.maxHealth,
				final = entity.def.isFinal == true,
			})
		end
		-- phase transitions
		local phases = entity.def.phases
		if phases then
			for index, phase in ipairs(phases) do
				if index > entity.phaseIndex and fraction <= phase.at then
					entity.phaseIndex = index
					entity.speed = entity.def.speed * (phase.speedMult or 1)
					entity.damage = math.floor(entity.def.damage * (phase.damageMult or 1))
					if phase.abilities then
						entity.abilities = abilityState(phase.abilities)
					end
					if phase.announce then
						Net.get("Announce"):FireAllClients({
							title = phase.announce,
							subtitle = entity.def.name,
							color = { entity.def.colors.glow.R * 255, entity.def.colors.glow.G * 255, entity.def.colors.glow.B * 255 },
							duration = 3,
						})
					end
				end
			end
		end
	end

	if entity.health <= 0 then
		killEntity(entity, attacker, headshot)
	end
	return dealt
end

-- Powerup: wipe the trash mobs, leave bosses standing.
function EnemyService.purge(awardTo)
	local victims = {}
	for _, entity in pairs(entities) do
		if entity.alive and not entity.isBoss then
			table.insert(victims, entity)
		end
	end
	for _, entity in ipairs(victims) do
		ashBurst(entity)
		if awardTo then
			S.Economy.addKill(awardTo)
		end
		despawn(entity)
	end
	return #victims
end

function EnemyService.clearAll()
	for _, entity in pairs(entities) do
		despawn(entity)
	end
	entities = {}
	aliveCount = 0
	boss = nil
	Net.get("BossState"):FireAllClients({ active = false })
end

--------------------------------------------------------------------------------
-- abilities
--------------------------------------------------------------------------------

local function ringFx(position, radius, color, lifetime)
	local ring = Instance.new("Part")
	ring.Shape = Enum.PartType.Cylinder
	ring.Size = Vector3.new(0.6, 2, 2)
	ring.CFrame = CFrame.new(position.X, 0.7, position.Z) * CFrame.Angles(0, 0, math.rad(90))
	ring.Anchored = true
	ring.CanCollide = false
	ring.Material = Enum.Material.Neon
	ring.Color = color
	ring.Transparency = 0.25
	ring.Parent = S.Map.fxFolder

	local tween = TweenService:Create(ring, TweenInfo.new(lifetime or 0.55, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = Vector3.new(0.6, radius * 2, radius * 2),
		Transparency = 1,
	})
	tween:Play()
	Debris:AddItem(ring, (lifetime or 0.55) + 0.2)
end

local function damagePlayersInRadius(center, radius, damage, sourceName)
	for _, target in ipairs(Util.activeTargets()) do
		local delta = target.root.Position - center
		local flat = Vector3.new(delta.X, 0, delta.Z)
		if flat.Magnitude <= radius and math.abs(delta.Y) < 20 then
			S.PlayerService.damage(target.player, damage, sourceName)
		end
	end
end

local abilityHandlers = {}

abilityHandlers.slam = function(entity, ability, target, dist)
	if dist > (ability.range or 14) then return false end
	entity.stunUntil = os.clock() + 0.75
	local center = entity.root.Position
	ringFx(center, ability.radius or 16, entity.def.colors.glow, 0.5)
	task.delay(0.45, function()
		if not entity.alive then return end
		damagePlayersInRadius(entity.root.Position, ability.radius or 16, ability.damage or 35, entity.def.name .. " slam")
		ringFx(entity.root.Position, (ability.radius or 16) * 0.6, entity.def.colors.glow, 0.35)
	end)
	return true
end

abilityHandlers.shockwave = function(entity, ability)
	entity.stunUntil = os.clock() + 1.0
	local radius = ability.radius or 30
	ringFx(entity.root.Position, radius, entity.def.colors.glow, 1.0)
	local center = entity.root.Position
	for step = 1, 3 do
		task.delay(step * 0.25, function()
			if not entity.alive then return end
			damagePlayersInRadius(center, radius * (step / 3), math.floor((ability.damage or 40) / 2), entity.def.name .. " shockwave")
		end)
	end
	return true
end

abilityHandlers.summon = function(entity, ability)
	local count = ability.count or 4
	for i = 1, count do
		local offset = Util.randomFlatOffset(entity.def.width * 2 + 8)
		local pos = entity.root.Position + offset
		pos = Vector3.new(
			math.clamp(pos.X, -S.Map.bounds + 8, S.Map.bounds - 8),
			0,
			math.clamp(pos.Z, -S.Map.bounds + 8, S.Map.bounds - 8)
		)
		local spawned = EnemyService.spawn(ability.enemy or "husk", entity.wave, pos, { insideAlready = true, healthMult = 0.8 })
		if spawned then
			ringFx(pos, 6, entity.def.colors.glow, 0.4)
		end
	end
	Net.get("Notify"):FireAllClients({
		text = entity.def.name .. " summons reinforcements",
		color = { 255, 170, 80 },
	})
	return true
end

abilityHandlers.blink = function(entity, ability, target)
	if not target then return false end
	local behind = target.root.Position - target.root.CFrame.LookVector * 10
	local pos = Vector3.new(behind.X, entity.y, behind.Z)
	ringFx(entity.root.Position, 10, entity.def.colors.glow, 0.3)
	entity.model:PivotTo(CFrame.new(pos))
	entity.path = nil
	ringFx(pos, 10, entity.def.colors.glow, 0.3)
	return true
end

abilityHandlers.charge = function(entity, ability, target, dist)
	if not target or dist > (ability.range or 60) or dist < 12 then return false end
	entity.chargeUntil = os.clock() + (ability.duration or 2)
	entity.chargeMult = ability.speedMult or 2.5
	entity.chargeDamage = ability.damage or entity.damage
	Net.get("Notify"):FireAllClients({
		text = entity.def.name .. " charges",
		color = { 255, 110, 110 },
	})
	return true
end

abilityHandlers.spit = function(entity, ability, target, dist)
	if not target or dist > (ability.range or 70) then return false end
	local origin = entity.root.Position + Vector3.new(0, entity.def.height * 0.3, 0)
	local goal = target.root.Position

	local blob = Instance.new("Part")
	blob.Shape = Enum.PartType.Ball
	blob.Size = Vector3.new(2.2, 2.2, 2.2)
	blob.Position = origin
	blob.Anchored = true
	blob.CanCollide = false
	blob.Material = Enum.Material.Neon
	blob.Color = entity.def.colors.glow
	blob.Parent = S.Map.fxFolder

	local travel = math.clamp((goal - origin).Magnitude / (ability.speed or 90), 0.2, 2.5)
	TweenService:Create(blob, TweenInfo.new(travel, Enum.EasingStyle.Linear), { Position = goal }):Play()
	task.delay(travel, function()
		if blob.Parent then
			ringFx(goal, ability.radius or 9, entity.def.colors.glow, 0.4)
			damagePlayersInRadius(goal, ability.radius or 9, ability.damage or 24, entity.def.name .. " bile")
			blob:Destroy()
		end
	end)
	return true
end

--------------------------------------------------------------------------------
-- steering
--------------------------------------------------------------------------------

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.IgnoreWater = true

local function refreshRayFilter()
	local filter = {}
	if S.Map then
		table.insert(filter, S.Map.enemyFolder)
		table.insert(filter, S.Map.fxFolder)
	end
	for _, player in ipairs(Players:GetPlayers()) do
		if player.Character then
			table.insert(filter, player.Character)
		end
	end
	rayParams.FilterDescendantsInstances = filter
end

local function hasLineOfSight(fromPos, toPos)
	local delta = toPos - fromPos
	local distance = delta.Magnitude
	if distance < 0.1 then return true end
	local result = workspace:Raycast(fromPos, delta.Unit * math.min(distance, 140), rayParams)
	return result == nil
end

local function requestPath(entity, goal)
	if entity.pathPending then return end
	entity.pathPending = true
	task.spawn(function()
		local path = PathfindingService:CreatePath({
			AgentRadius = math.max(2, entity.def.width * 0.6),
			AgentHeight = entity.def.height,
			AgentCanJump = false,
			WaypointSpacing = 8,
		})
		local ok = pcall(function()
			path:ComputeAsync(entity.root.Position, goal)
		end)
		if entity.alive and ok and path.Status == Enum.PathStatus.Success then
			local waypoints = path:GetWaypoints()
			entity.path = waypoints
			entity.pathIndex = math.min(2, #waypoints)
		else
			entity.path = nil
		end
		entity.pathPending = false
	end)
end

local function pickTarget(entity)
	local now = os.clock()
	if entity.target and now < entity.retargetAt then
		local character = entity.target.player and entity.target.player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if humanoid and humanoid.Health > 0 and entity.target.root and entity.target.root.Parent then
			return entity.target
		end
	end

	local candidates = Util.activeTargets()
	if #candidates == 0 then
		candidates = Util.anyLivingCharacters()
	end
	local best, bestDist
	local myPos = entity.root.Position
	for _, candidate in ipairs(candidates) do
		local dist = (candidate.root.Position - myPos).Magnitude
		if not bestDist or dist < bestDist then
			best, bestDist = candidate, dist
		end
	end
	entity.target = best
	entity.retargetAt = now + rng:NextNumber(1.2, 2.4)
	entity.path = nil
	return best
end

-- Separation so a pack does not collapse into one stack of cubes.
local function separation(entity)
	local push = Vector3.new()
	local myPos = entity.root.Position
	local personal = entity.def.width * 1.5
	local checked = 0
	for _, other in pairs(entities) do
		if other ~= entity and other.alive then
			local delta = myPos - other.root.Position
			local flat = Vector3.new(delta.X, 0, delta.Z)
			local dist = flat.Magnitude
			if dist > 0.01 and dist < personal then
				push = push + flat.Unit * ((personal - dist) / personal)
			end
			checked = checked + 1
			if checked > 24 then break end
		end
	end
	return push
end

local function moveEntity(entity, dt)
	local now = os.clock()
	if now < entity.stunUntil then return end

	local root = entity.root
	local myPos = root.Position
	local target = pickTarget(entity)

	local goalPos
	local gating = false

	if not entity.entered and entity.barrier then
		local barrier = entity.barrier
		local gate = barrier.origin
		local flatToGate = Vector3.new(gate.X - myPos.X, 0, gate.Z - myPos.Z)
		if flatToGate.Magnitude <= 8 then
			if entity.isBoss then
				S.BarrierService.smash(barrier)
				entity.entered = true
			elseif S.BarrierService.isOpen(barrier) then
				entity.entered = true
			else
				S.BarrierService.tear(barrier, dt, entity)
				gating = true
			end
		end
		goalPos = barrier.inside
		if entity.entered then
			goalPos = nil
		end
	end

	if gating then
		-- pressed against the boards: face the gap and keep clawing
		local look = Vector3.new(entity.barrier.inward.X, 0, entity.barrier.inward.Z)
		entity.model:PivotTo(CFrame.lookAt(Vector3.new(myPos.X, entity.y, myPos.Z), Vector3.new(myPos.X, entity.y, myPos.Z) + look))
		return
	end

	if not goalPos then
		if not target then
			return
		end
		goalPos = target.root.Position
	end

	local flat = Vector3.new(goalPos.X - myPos.X, 0, goalPos.Z - myPos.Z)
	local dist = flat.Magnitude
	local attackRange = GameConfig.EnemyAttackRange + entity.def.width * 0.5

	-- attack / abilities
	if target then
		local toTarget = target.root.Position - myPos
		local targetDist = Vector3.new(toTarget.X, 0, toTarget.Z).Magnitude
		if targetDist <= attackRange then
			if now - entity.lastAttack >= GameConfig.EnemyAttackCooldown then
				entity.lastAttack = now
				S.PlayerService.damage(target.player, entity.damage, entity.def.name)
			end
		end
		for _, slot in ipairs(entity.abilities) do
			if now >= slot.nextUse then
				local handler = abilityHandlers[slot.def.kind]
				if handler then
					local used = handler(entity, slot.def, target, targetDist)
					if used then
						slot.nextUse = now + slot.def.cooldown
					else
						slot.nextUse = now + 0.6
					end
				else
					slot.nextUse = now + slot.def.cooldown
				end
			end
		end
	end

	if dist <= attackRange * 0.9 then
		-- hold position but keep facing the player
		if dist > 0.05 then
			local look = flat.Unit
			entity.model:PivotTo(CFrame.lookAt(Vector3.new(myPos.X, entity.y, myPos.Z), Vector3.new(myPos.X, entity.y, myPos.Z) + look))
		end
		return
	end

	-- direction: straight line when possible, otherwise follow a computed path
	local eyePos = Vector3.new(myPos.X, entity.y, myPos.Z)
	local goalEye = Vector3.new(goalPos.X, entity.y, goalPos.Z)
	local direction

	if hasLineOfSight(eyePos, goalEye) then
		entity.path = nil
		direction = flat.Unit
	else
		if not entity.path or now - entity.pathAt > 1.4 then
			entity.pathAt = now
			requestPath(entity, goalPos)
		end
		if entity.path and entity.pathIndex <= #entity.path then
			local waypoint = entity.path[entity.pathIndex]
			local wpFlat = Vector3.new(waypoint.Position.X - myPos.X, 0, waypoint.Position.Z - myPos.Z)
			if wpFlat.Magnitude < 5 then
				entity.pathIndex = entity.pathIndex + 1
				if entity.pathIndex <= #entity.path then
					waypoint = entity.path[entity.pathIndex]
					wpFlat = Vector3.new(waypoint.Position.X - myPos.X, 0, waypoint.Position.Z - myPos.Z)
				end
			end
			if wpFlat.Magnitude > 0.05 then
				direction = wpFlat.Unit
			end
		end
		if not direction then
			-- last resort: sidestep the obstacle
			for _, degrees in ipairs({ 45, -45, 90, -90, 135, -135 }) do
				local rotated = CFrame.Angles(0, math.rad(degrees), 0) * flat.Unit
				if hasLineOfSight(eyePos, eyePos + rotated * 14) then
					direction = rotated
					break
				end
			end
		end
		direction = direction or flat.Unit
	end

	local speed = entity.speed
	if now < entity.chargeUntil then
		speed = speed * (entity.chargeMult or 2.4)
	end

	local push = separation(entity)
	local steer = direction + push * 0.55
	if steer.Magnitude < 0.05 then
		steer = direction
	end
	steer = steer.Unit

	local step = math.min(speed * dt, dist)
	local newPos = Vector3.new(myPos.X, entity.y, myPos.Z) + steer * step

	-- stay inside the world
	local limit = S.Map.bounds + 44
	newPos = Vector3.new(
		math.clamp(newPos.X, -limit, limit),
		entity.y + math.sin((now + entity.bob) * 6) * 0.18,
		math.clamp(newPos.Z, -limit, limit)
	)

	local lookAt = newPos + Vector3.new(steer.X, 0, steer.Z)
	local lurch = math.sin((now + entity.bob) * 5) * 0.09
	entity.model:PivotTo(CFrame.lookAt(newPos, lookAt) * CFrame.Angles(0, 0, lurch))
end

--------------------------------------------------------------------------------
-- lifecycle
--------------------------------------------------------------------------------

function EnemyService.init(services)
	S = services
	refreshRayFilter()
	Players.PlayerAdded:Connect(function(player)
		player.CharacterAdded:Connect(function()
			task.defer(refreshRayFilter)
		end)
		task.defer(refreshRayFilter)
	end)
	Players.PlayerRemoving:Connect(function()
		task.defer(refreshRayFilter)
	end)
	for _, player in ipairs(Players:GetPlayers()) do
		player.CharacterAdded:Connect(function()
			task.defer(refreshRayFilter)
		end)
	end

	local filterRefreshAt = 0
	heartbeatConn = RunService.Heartbeat:Connect(function(dt)
		accumulator = accumulator + dt
		if accumulator < TICK_RATE then return end
		local step = accumulator
		accumulator = 0

		local now = os.clock()
		if now - filterRefreshAt > 2 then
			filterRefreshAt = now
			refreshRayFilter()
		end

		for _, entity in pairs(entities) do
			if entity.alive and entity.root and entity.root.Parent then
				local ok, err = pcall(moveEntity, entity, step)
				if not ok and GameConfig.DebugLogging then
					warn("[Necrotide] enemy step failed: " .. tostring(err))
				end
			end
		end
	end)
end

function EnemyService.shutdown()
	if heartbeatConn then
		heartbeatConn:Disconnect()
		heartbeatConn = nil
	end
end

return EnemyService
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX15">
				<Properties>
					<string name="Name">Loadout</string>
					<ProtectedString name="Source"><![CDATA[-- Loadout: which guns a player is carrying, their ammo, reloads, swapping and
-- the physical gun model welded to the character. Authoritative: the client only
-- ever asks, it never tells.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("NecrotideShared")
local GameConfig = require(Shared.GameConfig)
local WeaponDefs = require(Shared.WeaponDefs)
local Net = require(Shared.Net)

local Loadout = {}
local S

local state = {}

local function ensure(player)
	local entry = state[player]
	if not entry then
		entry = {
			slots = {},
			active = 1,
			reloading = false,
			reloadEnd = 0,
			lastShot = 0,
			suppressed = false,
			model = nil,
		}
		state[player] = entry
	end
	return entry
end

function Loadout.push(player)
	local entry = ensure(player)
	local slots = {}
	for i = 1, GameConfig.MaxWeaponSlots do
		slots[i] = WeaponDefs.publicState(entry.slots[i])
	end
	Net.get("LoadoutChanged"):FireClient(player, {
		slots = slots,
		active = entry.active,
		reloading = entry.reloading,
		reloadDuration = entry.reloadDuration,
	})
end

function Loadout.active(player)
	local entry = ensure(player)
	return entry.slots[entry.active]
end

local function attachPoint(character)
	return character:FindFirstChild("RightHand")
		or character:FindFirstChild("Right Arm")
		or character:FindFirstChild("HumanoidRootPart")
end

-- Builds a small blocky gun and welds it to the right hand.
local function buildGunModel(player, inst)
	local entry = ensure(player)
	if entry.model then
		entry.model:Destroy()
		entry.model = nil
	end
	local character = player.Character
	if not character or not inst then return end
	local hand = attachPoint(character)
	if not hand then return end

	local def = WeaponDefs.get(inst.id)
	local body = (def and def.body) or { color = Color3.fromRGB(60, 60, 60), length = 2, bore = 0.25 }

	local model = Instance.new("Model")
	model.Name = "NecrotideGun"

	local function piece(name, size, offset, color, material)
		local part = Instance.new("Part")
		part.Name = name
		part.Size = size
		part.Color = color
		part.Material = material or Enum.Material.Metal
		part.CanCollide = false
		part.Massless = true
		part.TopSurface = Enum.SurfaceType.Smooth
		part.BottomSurface = Enum.SurfaceType.Smooth
		part.CFrame = hand.CFrame * CFrame.new(offset)
		part.Parent = model
		return part
	end

	local tint = inst.upgraded and (inst.tracerColor or Color3.fromRGB(150, 210, 255)) or body.color
	local receiver = piece("Receiver", Vector3.new(0.45, 0.6, body.length), Vector3.new(0, -0.6, -body.length * 0.4), tint)
	piece("Barrel", Vector3.new(body.bore, body.bore, body.length * 0.7), Vector3.new(0, -0.45, -body.length * 0.95), Color3.fromRGB(34, 34, 38))
	piece("Grip", Vector3.new(0.35, 0.7, 0.4), Vector3.new(0, -1.0, -body.length * 0.1), Color3.fromRGB(28, 26, 26), Enum.Material.Plastic)
	piece("Mag", Vector3.new(0.3, 0.6, 0.5), Vector3.new(0, -1.05, -body.length * 0.45), Color3.fromRGB(40, 40, 44))
	local sight = piece("Sight", Vector3.new(0.18, 0.22, 0.4), Vector3.new(0, -0.22, -body.length * 0.5), Color3.fromRGB(24, 24, 26))

	local muzzle = Instance.new("Part")
	muzzle.Name = "Muzzle"
	muzzle.Size = Vector3.new(0.2, 0.2, 0.2)
	muzzle.Transparency = 1
	muzzle.CanCollide = false
	muzzle.Massless = true
	muzzle.CFrame = hand.CFrame * CFrame.new(0, -0.45, -body.length * 1.3)
	muzzle.Parent = model

	if inst.upgraded then
		local glow = Instance.new("PointLight")
		glow.Color = inst.tracerColor or Color3.fromRGB(150, 210, 255)
		glow.Brightness = 1.6
		glow.Range = 12
		glow.Parent = receiver
		receiver.Material = Enum.Material.Neon
		sight.Color = inst.tracerColor or Color3.fromRGB(150, 210, 255)
	end

	model.PrimaryPart = receiver
	for _, part in ipairs(model:GetChildren()) do
		if part:IsA("BasePart") then
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = hand
			weld.Part1 = part
			weld.Parent = part
			part.Anchored = false
		end
	end
	model.Parent = character
	entry.model = model
end

function Loadout.refreshModel(player)
	buildGunModel(player, Loadout.active(player))
end

function Loadout.setSuppressed(player, suppressed)
	ensure(player).suppressed = suppressed
end

function Loadout.onCharacter(player, character)
	local entry = ensure(player)
	entry.reloading = false
	entry.reloadEnd = 0
	entry.suppressed = false
	if #entry.slots == 0 then
		entry.slots[1] = WeaponDefs.makeInstance(WeaponDefs.StartingWeapon, false)
		entry.active = 1
	end
	task.defer(function()
		if player.Character == character then
			buildGunModel(player, Loadout.active(player))
			Loadout.push(player)
		end
	end)
end

-- Combat asks for permission to fire. Returns the weapon instance on success.
function Loadout.consumeShot(player)
	local entry = ensure(player)
	if entry.suppressed then return nil, "suppressed" end
	if S.PlayerService.isDowned(player) or S.PlayerService.isOut(player) then return nil, "down" end
	local inst = entry.slots[entry.active]
	if not inst then return nil, "empty" end

	local now = os.clock()
	if entry.reloading then
		if now < entry.reloadEnd then
			return nil, "reloading"
		end
		-- reload finished while nobody polled it
		Loadout.finishReload(player)
	end
	if inst.ammo <= 0 then
		Loadout.reload(player)
		return nil, "dry"
	end
	local interval = 60 / math.max(1, inst.rpm)
	if now - entry.lastShot < interval * 0.85 then
		return nil, "rate"
	end
	entry.lastShot = now
	inst.ammo = inst.ammo - 1
	Loadout.push(player)
	return inst
end

function Loadout.finishReload(player)
	local entry = ensure(player)
	local inst = entry.slots[entry.active]
	entry.reloading = false
	entry.reloadEnd = 0
	if not inst then return end
	local need = inst.mag - inst.ammo
	local take = math.min(need, inst.spare)
	inst.ammo = inst.ammo + take
	inst.spare = inst.spare - take
	Loadout.push(player)
end

function Loadout.reload(player)
	local entry = ensure(player)
	local inst = entry.slots[entry.active]
	if not inst or entry.reloading then return false end
	if inst.ammo >= inst.mag or inst.spare <= 0 then return false end
	if entry.suppressed or S.PlayerService.isDowned(player) then return false end

	local scale = S.PlayerService.tonicAgg(player).reloadScale
	local duration = inst.reloadTime * scale
	entry.reloading = true
	entry.reloadEnd = os.clock() + duration
	entry.reloadDuration = duration
	Loadout.push(player)

	task.delay(duration, function()
		local current = state[player]
		if not current or not current.reloading then return end
		if current.slots[current.active] ~= inst then
			current.reloading = false
			current.reloadEnd = 0
			Loadout.push(player)
			return
		end
		Loadout.finishReload(player)
	end)
	return true
end

function Loadout.swap(player, index)
	local entry = ensure(player)
	index = math.floor(tonumber(index) or 0)
	if index < 1 or index > GameConfig.MaxWeaponSlots then return false end
	if index == entry.active or not entry.slots[index] then return false end
	entry.active = index
	entry.reloading = false
	entry.reloadEnd = 0
	buildGunModel(player, entry.slots[index])
	Loadout.push(player)
	return true
end

-- Gives a weapon, filling an empty slot first, otherwise replacing the held one.
function Loadout.give(player, weaponId, upgraded)
	local inst = WeaponDefs.makeInstance(weaponId, upgraded)
	if not inst then return false end
	local entry = ensure(player)

	for i = 1, GameConfig.MaxWeaponSlots do
		if entry.slots[i] and entry.slots[i].id == weaponId then
			-- already owned: top the ammo off instead of duplicating
			local existing = entry.slots[i]
			if upgraded and not existing.upgraded then
				entry.slots[i] = inst
			else
				existing.ammo = existing.mag
				existing.spare = existing.reserve
			end
			entry.active = i
			entry.reloading = false
			buildGunModel(player, entry.slots[i])
			Loadout.push(player)
			return true
		end
	end

	local target
	for i = 1, GameConfig.MaxWeaponSlots do
		if not entry.slots[i] then
			target = i
			break
		end
	end
	target = target or entry.active
	entry.slots[target] = inst
	entry.active = target
	entry.reloading = false
	entry.reloadEnd = 0
	buildGunModel(player, inst)
	Loadout.push(player)
	return true
end

function Loadout.upgradeActive(player)
	local entry = ensure(player)
	local inst = entry.slots[entry.active]
	if not inst then return false, "nothing held" end
	if inst.upgraded then return false, "already forged" end
	local upgraded = WeaponDefs.makeInstance(inst.id, true)
	if not upgraded then return false, "cannot forge" end
	entry.slots[entry.active] = upgraded
	entry.reloading = false
	entry.reloadEnd = 0
	buildGunModel(player, upgraded)
	Loadout.push(player)
	return true, upgraded.name
end

-- Used by the Overforge: upgrades a specific slot, but only if the same weapon is
-- still sitting in it when the machine finishes.
function Loadout.upgradeSlot(player, slotIndex, weaponId)
	local entry = ensure(player)
	local inst = entry.slots[slotIndex]
	if not inst or inst.id ~= weaponId then return false, "weapon moved" end
	if inst.upgraded then return false, "already forged" end
	local upgraded = WeaponDefs.makeInstance(weaponId, true)
	if not upgraded then return false, "cannot forge" end
	entry.slots[slotIndex] = upgraded
	if entry.active == slotIndex then
		entry.reloading = false
		entry.reloadEnd = 0
		buildGunModel(player, upgraded)
	end
	Loadout.push(player)
	return true, upgraded.name
end

function Loadout.refillActive(player)
	local entry = ensure(player)
	local inst = entry.slots[entry.active]
	if not inst then return false end
	inst.ammo = inst.mag
	inst.spare = inst.reserve
	Loadout.push(player)
	return true
end

function Loadout.refillWeapon(player, weaponId)
	local entry = ensure(player)
	for i = 1, GameConfig.MaxWeaponSlots do
		local inst = entry.slots[i]
		if inst and inst.id == weaponId then
			inst.ammo = inst.mag
			inst.spare = inst.reserve
			Loadout.push(player)
			return true
		end
	end
	return false
end

function Loadout.maxAmmoEveryone()
	for _, player in ipairs(Players:GetPlayers()) do
		local entry = ensure(player)
		for i = 1, GameConfig.MaxWeaponSlots do
			local inst = entry.slots[i]
			if inst then
				inst.ammo = inst.mag
				inst.spare = inst.reserve
			end
		end
		Loadout.push(player)
	end
end

function Loadout.has(player, weaponId)
	local entry = ensure(player)
	for i = 1, GameConfig.MaxWeaponSlots do
		if entry.slots[i] and entry.slots[i].id == weaponId then
			return true, i
		end
	end
	return false
end

function Loadout.resetForNewRun()
	for _, player in ipairs(Players:GetPlayers()) do
		local entry = ensure(player)
		entry.slots = { WeaponDefs.makeInstance(WeaponDefs.StartingWeapon, false) }
		entry.active = 1
		entry.reloading = false
		entry.reloadEnd = 0
		buildGunModel(player, entry.slots[1])
		Loadout.push(player)
	end
end

function Loadout.snapshot(player)
	local entry = ensure(player)
	local slots = {}
	for i = 1, GameConfig.MaxWeaponSlots do
		slots[i] = WeaponDefs.publicState(entry.slots[i])
	end
	return { slots = slots, active = entry.active, reloading = entry.reloading, reloadDuration = entry.reloadDuration }
end

function Loadout.init(services)
	S = services

	Net.get("ReloadRequest").OnServerEvent:Connect(function(player)
		Loadout.reload(player)
	end)

	Net.get("SwapRequest").OnServerEvent:Connect(function(player, index)
		if typeof(index) ~= "number" then return end
		Loadout.swap(player, index)
	end)

	Players.PlayerRemoving:Connect(function(player)
		state[player] = nil
	end)
end

return Loadout
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX16">
				<Properties>
					<string name="Name">MapBuilder</string>
					<ProtectedString name="Source"><![CDATA[-- MapBuilder: generates "The Ashvault" arena from data at runtime.
-- Nothing about the map is stored in the place file, so the whole layout can be
-- retuned by editing the tables at the top of this module.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Lighting = game:GetService("Lighting")

local Shared = ReplicatedStorage:WaitForChild("NecrotideShared")
local GameConfig = require(Shared.GameConfig)

local MapBuilder = {}

local WALL_HEIGHT = 22
local WALL_THICK = 4
local ARENA = 110 -- perimeter half-extent
local GAP = 14 -- barrier opening width

local PALETTE = {
	floor = Color3.fromRGB(64, 62, 58),
	floorAlt = Color3.fromRGB(52, 50, 48),
	wall = Color3.fromRGB(82, 78, 72),
	innerWall = Color3.fromRGB(96, 90, 82),
	trim = Color3.fromRGB(44, 42, 40),
	board = Color3.fromRGB(122, 84, 48),
	accent = Color3.fromRGB(255, 140, 50),
}

-- Barrier openings in the perimeter wall. `axis` is the wall the gap sits in.
local BARRIERS = {
	{ id = "north_west", axis = "north", along = -58 },
	{ id = "north_east", axis = "north", along = 42 },
	{ id = "south_west", axis = "south", along = -46 },
	{ id = "south_east", axis = "south", along = 54 },
	{ id = "west_mid", axis = "west", along = 18 },
	{ id = "east_mid", axis = "east", along = -22 },
}

-- Four buildings around a cross-shaped courtyard. Doors are gaps in a side.
local BUILDINGS = {
	{ id = "vault_nw", center = Vector2.new(-58, -58), size = Vector2.new(60, 54), doors = { "south", "east" } },
	{ id = "vault_ne", center = Vector2.new(58, -58), size = Vector2.new(60, 54), doors = { "south", "west" } },
	{ id = "vault_sw", center = Vector2.new(-58, 58), size = Vector2.new(60, 54), doors = { "north", "east" } },
	{ id = "vault_se", center = Vector2.new(58, 58), size = Vector2.new(60, 54), doors = { "north", "west" } },
}

-- Cover props in the courtyard so the middle is not a flat killing field.
local COVER = {
	{ pos = Vector3.new(0, 2, -34), size = Vector3.new(22, 4, 5) },
	{ pos = Vector3.new(0, 2, 34), size = Vector3.new(22, 4, 5) },
	{ pos = Vector3.new(-34, 2, 0), size = Vector3.new(5, 4, 22) },
	{ pos = Vector3.new(34, 2, 0), size = Vector3.new(5, 4, 22) },
	{ pos = Vector3.new(-16, 3, -16), size = Vector3.new(7, 6, 7) },
	{ pos = Vector3.new(16, 3, 16), size = Vector3.new(7, 6, 7) },
	{ pos = Vector3.new(16, 1.5, -16), size = Vector3.new(9, 3, 9) },
	{ pos = Vector3.new(-16, 1.5, 16), size = Vector3.new(9, 3, 9) },
}

-- Armory Racks: buyable wall weapons. `pos` sits just off a wall face and `face`
-- points away from that wall, into the room the player stands in. The wall planes
-- these hang on are:
--   courtyard-facing outer walls of the north buildings   z = -29.5
--   NW building, interior west wall                       x = -86.5
--   NE building, interior north wall                      z = -83.5
--   SE building, interior east wall                       x =  86.5
--   SW building, interior south wall                      z =  83.5
local WALL_BUYS = {
	{ weapon = "vesper45", pos = Vector3.new(-40, 4, -29.0), face = Vector3.new(0, 0, 1) },
	{ weapon = "scrapper", pos = Vector3.new(40, 4, -29.0), face = Vector3.new(0, 0, 1) },
	{ weapon = "ranger12", pos = Vector3.new(-86.0, 4, -60), face = Vector3.new(1, 0, 0) },
	{ weapon = "hornet", pos = Vector3.new(58, 4, -83.0), face = Vector3.new(0, 0, 1) },
	{ weapon = "cyclone", pos = Vector3.new(86.0, 4, 58), face = Vector3.new(-1, 0, 0) },
	{ weapon = "talon", pos = Vector3.new(-58, 4, 83.0), face = Vector3.new(0, 0, -1) },
}

-- Tonic Stills.
local TONIC_SPOTS = {
	{ tonic = "ironhide", pos = Vector3.new(-72, 0, -44) },
	{ tonic = "quickhands", pos = Vector3.new(72, 0, -44) },
	{ tonic = "fleetfoot", pos = Vector3.new(-72, 0, 44) },
	{ tonic = "scavenger", pos = Vector3.new(72, 0, 44) },
	{ tonic = "deadeye", pos = Vector3.new(0, 0, -46) },
	{ tonic = "secondwind", pos = Vector3.new(0, 0, 46) },
}

-- The Fate Crate hops between these anchors when the Hollow Doll shows up.
local CRATE_SPOTS = {
	Vector3.new(-40, 0, -40),
	Vector3.new(44, 0, -38),
	Vector3.new(-42, 0, 42),
	Vector3.new(40, 0, 40),
	Vector3.new(0, 0, 62),
}

local FORGE_SPOT = Vector3.new(-58, 0, 58)
-- south of the central brazier, so nobody spawns inside it
local PLAYER_SPAWN = Vector3.new(0, 4, 20)

local function newPart(name, size, position, color, parent, material)
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.Position = position
	part.Anchored = true
	part.Color = color
	part.Material = material or Enum.Material.Concrete
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = parent
	return part
end

-- Builds one side of a rectangle, skipping the given gaps.
-- `gaps` is a list of { center = n, width = n } along the side's long axis.
local function wallWithGaps(parent, name, isHorizontal, fixed, from, to, gaps, height, thickness, color)
	local cuts = {}
	for _, gap in ipairs(gaps or {}) do
		table.insert(cuts, { gap.center - gap.width * 0.5, gap.center + gap.width * 0.5 })
	end
	table.sort(cuts, function(a, b) return a[1] < b[1] end)

	local cursor = from
	local index = 0
	local function segment(a, b)
		if b - a <= 0.05 then return end
		index = index + 1
		local mid = (a + b) * 0.5
		local length = b - a
		local size, pos
		if isHorizontal then
			size = Vector3.new(length, height, thickness)
			pos = Vector3.new(mid, height * 0.5, fixed)
		else
			size = Vector3.new(thickness, height, length)
			pos = Vector3.new(fixed, height * 0.5, mid)
		end
		newPart(name .. "_" .. index, size, pos, color, parent)
	end

	for _, cut in ipairs(cuts) do
		segment(cursor, math.max(cursor, cut[1]))
		cursor = math.max(cursor, cut[2])
	end
	segment(cursor, to)
end

local function buildFloor(parent)
	local floor = newPart("Floor", Vector3.new(ARENA * 2 + WALL_THICK * 2, 2, ARENA * 2 + WALL_THICK * 2), Vector3.new(0, -1, 0), PALETTE.floor, parent, Enum.Material.Slate)
	floor.Name = "Floor"

	-- checkered inlay so the courtyard reads as a built space
	for x = -3, 3 do
		for z = -3, 3 do
			if (x + z) % 2 == 0 then
				newPart("Inlay", Vector3.new(22, 0.2, 22), Vector3.new(x * 22, 0.1, z * 22), PALETTE.floorAlt, parent, Enum.Material.Concrete)
			end
		end
	end

	-- kill plane far below in case anything falls out of the world
	local void = newPart("VoidCatcher", Vector3.new(600, 2, 600), Vector3.new(0, -120, 0), Color3.fromRGB(20, 12, 12), parent, Enum.Material.Neon)
	void.Transparency = 0.7
	void.CanCollide = false
	void:SetAttribute("NecrotideVoid", true)
	return floor
end

local function buildPerimeter(parent)
	local gapsBySide = { north = {}, south = {}, east = {}, west = {} }
	for _, barrier in ipairs(BARRIERS) do
		table.insert(gapsBySide[barrier.axis], { center = barrier.along, width = GAP })
	end

	wallWithGaps(parent, "WallNorth", true, -ARENA, -ARENA, ARENA, gapsBySide.north, WALL_HEIGHT, WALL_THICK, PALETTE.wall)
	wallWithGaps(parent, "WallSouth", true, ARENA, -ARENA, ARENA, gapsBySide.south, WALL_HEIGHT, WALL_THICK, PALETTE.wall)
	wallWithGaps(parent, "WallWest", false, -ARENA, -ARENA, ARENA, gapsBySide.west, WALL_HEIGHT, WALL_THICK, PALETTE.wall)
	wallWithGaps(parent, "WallEast", false, ARENA, -ARENA, ARENA, gapsBySide.east, WALL_HEIGHT, WALL_THICK, PALETTE.wall)

	-- outer apron so spawned enemies have ground to stand on
	newPart("Apron", Vector3.new(ARENA * 2 + 120, 2, ARENA * 2 + 120), Vector3.new(0, -1.2, 0), Color3.fromRGB(38, 36, 34), parent, Enum.Material.Ground)
end

local function barrierTransform(barrier)
	-- returns position of the gap centre, the inward direction, and a wall axis
	if barrier.axis == "north" then
		return Vector3.new(barrier.along, 0, -ARENA), Vector3.new(0, 0, 1), Vector3.new(1, 0, 0)
	elseif barrier.axis == "south" then
		return Vector3.new(barrier.along, 0, ARENA), Vector3.new(0, 0, -1), Vector3.new(1, 0, 0)
	elseif barrier.axis == "west" then
		return Vector3.new(-ARENA, 0, barrier.along), Vector3.new(1, 0, 0), Vector3.new(0, 0, 1)
	end
	return Vector3.new(ARENA, 0, barrier.along), Vector3.new(-1, 0, 0), Vector3.new(0, 0, 1)
end

local function buildBarriers(parent)
	local out = {}
	for _, barrier in ipairs(BARRIERS) do
		local origin, inward, along = barrierTransform(barrier)
		local model = Instance.new("Model")
		model.Name = "Barrier_" .. barrier.id
		model.Parent = parent

		-- frame posts on both sides of the gap
		for _, side in ipairs({ -1, 1 }) do
			local postPos = origin + along * (GAP * 0.5 + 1) * side + Vector3.new(0, WALL_HEIGHT * 0.5, 0)
			local post = newPart("Post", Vector3.new(2, WALL_HEIGHT, WALL_THICK + 0.4), postPos, PALETTE.trim, model)
			if barrier.axis == "west" or barrier.axis == "east" then
				post.Size = Vector3.new(WALL_THICK + 0.4, WALL_HEIGHT, 2)
			end
		end
		-- lintel above the gap
		local lintelSize = Vector3.new(GAP + 4, 6, WALL_THICK)
		if barrier.axis == "west" or barrier.axis == "east" then
			lintelSize = Vector3.new(WALL_THICK, 6, GAP + 4)
		end
		newPart("Lintel", lintelSize, origin + Vector3.new(0, WALL_HEIGHT - 3, 0), PALETTE.wall, model)

		local boards = {}
		for i = 1, GameConfig.BoardsPerBarrier do
			local height = 2.6 + (i - 1) * 2.7
			local boardSize = Vector3.new(GAP - 0.5, 1.5, 1.2)
			if barrier.axis == "west" or barrier.axis == "east" then
				boardSize = Vector3.new(1.2, 1.5, GAP - 0.5)
			end
			local board = newPart("Board" .. i, boardSize, origin + Vector3.new(0, height, 0), PALETTE.board, model, Enum.Material.WoodPlanks)
			board.Rotation = Vector3.new(0, 0, (i % 2 == 0) and 4 or -4)
			table.insert(boards, board)
		end

		local promptAnchor = newPart("PromptAnchor", Vector3.new(2, 2, 2), origin + inward * 3 + Vector3.new(0, 4, 0), PALETTE.trim, model)
		promptAnchor.Transparency = 1
		promptAnchor.CanCollide = false

		table.insert(out, {
			id = barrier.id,
			model = model,
			boards = boards,
			origin = origin,
			inward = inward,
			promptAnchor = promptAnchor,
			-- ground level: EnemyService lifts models by half their height
			outside = origin + inward * -16,
			inside = origin + inward * 14,
		})
	end
	return out
end

local function buildBuildings(parent)
	for _, b in ipairs(BUILDINGS) do
		local model = Instance.new("Model")
		model.Name = b.id
		model.Parent = parent

		local minX, maxX = b.center.X - b.size.X * 0.5, b.center.X + b.size.X * 0.5
		local minZ, maxZ = b.center.Y - b.size.Y * 0.5, b.center.Y + b.size.Y * 0.5
		local doorSet = {}
		for _, side in ipairs(b.doors) do
			doorSet[side] = true
		end

		local function gapsFor(side, axisCenter)
			if doorSet[side] then
				return { { center = axisCenter, width = 16 } }
			end
			return {}
		end

		wallWithGaps(model, b.id .. "_N", true, minZ, minX, maxX, gapsFor("north", b.center.X), 18, 3, PALETTE.innerWall)
		wallWithGaps(model, b.id .. "_S", true, maxZ, minX, maxX, gapsFor("south", b.center.X), 18, 3, PALETTE.innerWall)
		wallWithGaps(model, b.id .. "_W", false, minX, minZ, maxZ, gapsFor("west", b.center.Y), 18, 3, PALETTE.innerWall)
		wallWithGaps(model, b.id .. "_E", false, maxX, minZ, maxZ, gapsFor("east", b.center.Y), 18, 3, PALETTE.innerWall)

		-- interior detail: a few crates and a hanging lamp
		newPart(b.id .. "_Crate1", Vector3.new(6, 6, 6), Vector3.new(minX + 8, 3, minZ + 8), Color3.fromRGB(96, 74, 48), model, Enum.Material.WoodPlanks)
		newPart(b.id .. "_Crate2", Vector3.new(5, 5, 5), Vector3.new(maxX - 9, 2.5, maxZ - 9), Color3.fromRGB(88, 68, 44), model, Enum.Material.WoodPlanks)

		local lamp = newPart(b.id .. "_Lamp", Vector3.new(3, 0.6, 3), Vector3.new(b.center.X, 15, b.center.Y), PALETTE.accent, model, Enum.Material.Neon)
		lamp.CanCollide = false
		local light = Instance.new("PointLight")
		light.Color = Color3.fromRGB(255, 176, 108)
		light.Brightness = 2.2
		light.Range = 46
		light.Shadows = true
		light.Parent = lamp
	end
end

local function buildCover(parent)
	for i, prop in ipairs(COVER) do
		newPart("Cover" .. i, prop.size, prop.pos, PALETTE.innerWall, parent, Enum.Material.Cobblestone)
	end

	-- central brazier: the visual anchor of the courtyard
	local base = newPart("BrazierBase", Vector3.new(10, 3, 10), Vector3.new(0, 1.5, 0), PALETTE.trim, parent, Enum.Material.Slate)
	local bowl = newPart("BrazierBowl", Vector3.new(6, 2, 6), Vector3.new(0, 4, 0), PALETTE.accent, parent, Enum.Material.Neon)
	bowl.CanCollide = false
	local fire = Instance.new("Fire")
	fire.Size = 18
	fire.Heat = 12
	fire.Color = Color3.fromRGB(255, 150, 60)
	fire.SecondaryColor = Color3.fromRGB(120, 40, 10)
	fire.Parent = bowl
	local light = Instance.new("PointLight")
	light.Brightness = 4
	light.Range = 70
	light.Color = Color3.fromRGB(255, 160, 80)
	light.Parent = bowl
	return base
end

local function buildSpawn(parent)
	local pad = newPart("SpawnPad", Vector3.new(26, 0.6, 26), Vector3.new(PLAYER_SPAWN.X, 0.3, PLAYER_SPAWN.Z), Color3.fromRGB(70, 90, 110), parent, Enum.Material.Metal)
	pad.CanCollide = false

	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "AshvaultSpawn"
	spawn.Size = Vector3.new(12, 1, 12)
	spawn.Position = PLAYER_SPAWN - Vector3.new(0, 3.6, 0)
	spawn.Anchored = true
	spawn.Transparency = 1
	spawn.CanCollide = false
	spawn.Duration = 0
	spawn.Neutral = true
	spawn.Parent = parent
	return spawn
end

local function applyLighting()
	Lighting.Ambient = Color3.fromRGB(38, 36, 44)
	Lighting.OutdoorAmbient = Color3.fromRGB(46, 44, 56)
	Lighting.Brightness = 1.4
	Lighting.ClockTime = 0.6
	Lighting.GeographicLatitude = 12
	Lighting.FogColor = Color3.fromRGB(18, 16, 22)
	Lighting.FogStart = 60
	Lighting.FogEnd = 420
	Lighting.EnvironmentDiffuseScale = 0.4
	Lighting.GlobalShadows = true

	if not Lighting:FindFirstChildOfClass("Atmosphere") then
		local atmosphere = Instance.new("Atmosphere")
		atmosphere.Density = 0.42
		atmosphere.Offset = 0.1
		atmosphere.Color = Color3.fromRGB(150, 140, 160)
		atmosphere.Decay = Color3.fromRGB(80, 70, 90)
		atmosphere.Glare = 0.2
		atmosphere.Haze = 2.2
		atmosphere.Parent = Lighting
	end
	if not Lighting:FindFirstChild("NecrotideBloom") then
		local bloom = Instance.new("BloomEffect")
		bloom.Name = "NecrotideBloom"
		bloom.Intensity = 0.45
		bloom.Size = 26
		bloom.Threshold = 1.1
		bloom.Parent = Lighting
	end
	if not Lighting:FindFirstChild("NecrotideGrade") then
		local cc = Instance.new("ColorCorrectionEffect")
		cc.Name = "NecrotideGrade"
		cc.Brightness = -0.03
		cc.Contrast = 0.16
		cc.Saturation = -0.12
		cc.TintColor = Color3.fromRGB(226, 220, 235)
		cc.Parent = Lighting
	end
end

function MapBuilder.build()
	local existing = workspace:FindFirstChild("Ashvault")
	if existing then
		existing:Destroy()
	end

	local root = Instance.new("Folder")
	root.Name = "Ashvault"
	root.Parent = workspace

	local structure = Instance.new("Folder")
	structure.Name = "Structure"
	structure.Parent = root

	buildFloor(structure)
	buildPerimeter(structure)
	buildBuildings(structure)
	buildCover(structure)
	local spawnLocation = buildSpawn(structure)

	local barrierFolder = Instance.new("Folder")
	barrierFolder.Name = "Barriers"
	barrierFolder.Parent = root
	local barriers = buildBarriers(barrierFolder)

	local stationFolder = Instance.new("Folder")
	stationFolder.Name = "Stations"
	stationFolder.Parent = root

	local enemyFolder = Instance.new("Folder")
	enemyFolder.Name = "Enemies"
	enemyFolder.Parent = root

	local fxFolder = Instance.new("Folder")
	fxFolder.Name = "Fx"
	fxFolder.Parent = root

	applyLighting()

	local spawnPoints = {}
	for _, barrier in ipairs(barriers) do
		table.insert(spawnPoints, { position = barrier.outside, barrier = barrier })
		-- a second, wider spawn ring position per barrier for big waves
		table.insert(spawnPoints, { position = barrier.origin + barrier.inward * -30, barrier = barrier })
	end

	return {
		root = root,
		structure = structure,
		stationFolder = stationFolder,
		enemyFolder = enemyFolder,
		fxFolder = fxFolder,
		barriers = barriers,
		spawnPoints = spawnPoints,
		wallBuys = WALL_BUYS,
		tonicSpots = TONIC_SPOTS,
		cratePositions = CRATE_SPOTS,
		forgePosition = FORGE_SPOT,
		playerSpawn = PLAYER_SPAWN,
		spawnLocation = spawnLocation,
		bounds = ARENA,
		newPart = newPart,
		palette = PALETTE,
	}
end

return MapBuilder
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX17">
				<Properties>
					<string name="Name">PlayerService</string>
					<ProtectedString name="Source"><![CDATA[-- PlayerService: player vitality, tonics, the downed/revive loop and squad-wipe
-- detection. All damage dealt to players funnels through PlayerService.damage so
-- nobody ever dies outright while a teammate could still pick them up.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("NecrotideShared")
local GameConfig = require(Shared.GameConfig)
local TonicDefs = require(Shared.TonicDefs)
local Net = require(Shared.Net)

local PlayerService = {}
local S

local state = {}
local heartbeatConn

local function ensure(player)
	local entry = state[player]
	if not entry then
		entry = {
			tonics = {},
			downed = false,
			out = false,
			bleedEnd = 0,
			lastDamage = 0,
			selfReviveUsed = false,
			revives = 0,
			downs = 0,
			prompt = nil,
		}
		state[player] = entry
	end
	return entry
end

function PlayerService.tonicAgg(player)
	local entry = ensure(player)
	if not entry.agg then
		entry.agg = TonicDefs.aggregate(entry.tonics)
	end
	return entry.agg
end

local function applyBody(player)
	local entry = ensure(player)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid then return end
	local agg = PlayerService.tonicAgg(player)
	local maxHealth = GameConfig.BaseMaxHealth + agg.bonusHealth
	local ratio = humanoid.MaxHealth > 0 and (humanoid.Health / humanoid.MaxHealth) or 1
	humanoid.MaxHealth = maxHealth
	if entry.downed then
		humanoid.Health = math.max(1, math.floor(maxHealth * 0.08))
	else
		humanoid.Health = math.clamp(maxHealth * ratio, 1, maxHealth)
	end
	if not entry.downed then
		humanoid.WalkSpeed = 16 * agg.speedMult
		humanoid.UseJumpPower = true
		humanoid.JumpPower = 50
	end
end

function PlayerService.pushTonics(player)
	local entry = ensure(player)
	local list = {}
	for id, has in pairs(entry.tonics) do
		if has then
			table.insert(list, id)
		end
	end
	Net.get("TonicsChanged"):FireClient(player, list)
end

function PlayerService.hasTonic(player, id)
	return ensure(player).tonics[id] == true
end

function PlayerService.grantTonic(player, id)
	local def = TonicDefs.get(id)
	if not def then return false end
	local entry = ensure(player)
	if entry.tonics[id] then return false end
	entry.tonics[id] = true
	entry.agg = nil
	applyBody(player)
	PlayerService.pushTonics(player)
	return true
end

function PlayerService.clearTonics(player)
	local entry = ensure(player)
	entry.tonics = {}
	entry.agg = nil
	PlayerService.pushTonics(player)
end

function PlayerService.isDowned(player)
	return ensure(player).downed
end

function PlayerService.isOut(player)
	return ensure(player).out
end

local function pushDowned(player)
	local entry = ensure(player)
	Net.get("DownedState"):FireClient(player, {
		downed = entry.downed,
		out = entry.out,
		-- seconds left, so the client never has to reason about server clocks
		bleedRemaining = math.max(0, entry.bleedEnd - os.clock()),
		bleedTotal = GameConfig.BleedOutTime,
		canSelfRevive = PlayerService.tonicAgg(player).selfRevive and not entry.selfReviveUsed,
	})
end

local function removePrompt(player)
	local entry = ensure(player)
	if entry.prompt then
		entry.prompt:Destroy()
		entry.prompt = nil
	end
end

-- True when nobody is left standing.
local function squadWiped()
	local anyUp = false
	for _, player in ipairs(Players:GetPlayers()) do
		local entry = ensure(player)
		local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		if not entry.out and not entry.downed and humanoid and humanoid.Health > 0 then
			anyUp = true
		end
	end
	return not anyUp
end

local function checkWipe()
	if #Players:GetPlayers() == 0 then return end
	if squadWiped() and S.WaveService then
		S.WaveService.endRun(false)
	end
end

function PlayerService.reviveTo(player, healthFraction)
	local entry = ensure(player)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	entry.downed = false
	entry.bleedEnd = 0
	player:SetAttribute("Downed", false)
	removePrompt(player)
	if humanoid then
		applyBody(player)
		humanoid.Health = humanoid.MaxHealth * (healthFraction or 1)
		local agg = PlayerService.tonicAgg(player)
		humanoid.WalkSpeed = 16 * agg.speedMult
		humanoid.UseJumpPower = true
		humanoid.JumpPower = 50
		humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
	end
	if S.Loadout then
		S.Loadout.setSuppressed(player, false)
	end
	pushDowned(player)
end

local function setOut(player)
	local entry = ensure(player)
	entry.downed = false
	entry.out = true
	entry.bleedEnd = 0
	player:SetAttribute("Downed", true)
	removePrompt(player)
	local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if humanoid and humanoid.Health > 0 then
		humanoid.Health = 0
	end
	pushDowned(player)
	Net.get("Announce"):FireAllClients({
		title = player.DisplayName .. " BLED OUT",
		subtitle = "Back on the next wave",
		color = { 255, 90, 90 },
		duration = 3,
	})
	checkWipe()
end

local function buildRevivePrompt(player)
	local entry = ensure(player)
	local character = player.Character
	local root = character and (character.PrimaryPart or character:FindFirstChild("HumanoidRootPart"))
	if not root then return end
	removePrompt(player)

	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "RevivePrompt"
	prompt.ActionText = "Revive " .. player.DisplayName
	prompt.ObjectText = "DOWNED"
	prompt.HoldDuration = GameConfig.ReviveTime
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	prompt.KeyboardKeyCode = Enum.KeyCode.F
	prompt.GamepadKeyCode = Enum.KeyCode.ButtonY
	prompt.Parent = root
	entry.prompt = prompt

	prompt.Triggered:Connect(function(triggerer)
		if not entry.downed then return end
		if triggerer == player then
			-- only legal with the Second Wind Phial, once per wave
			local agg = PlayerService.tonicAgg(player)
			if not agg.selfRevive or entry.selfReviveUsed then
				return
			end
			entry.selfReviveUsed = true
			PlayerService.reviveTo(player, 0.6)
			Net.get("Notify"):FireClient(player, { text = "Second Wind spent", color = { 255, 255, 255 } })
			return
		end
		local helperEntry = ensure(triggerer)
		if helperEntry.downed or helperEntry.out then return end
		PlayerService.reviveTo(player, 1)
		helperEntry.revives = helperEntry.revives + 1
		S.Economy.add(triggerer, GameConfig.SalvagePerRevive, true)
		Net.get("Notify"):FireClient(triggerer, {
			text = "Revived " .. player.DisplayName .. "  +" .. GameConfig.SalvagePerRevive,
			color = { 150, 255, 150 },
		})
		Net.get("Notify"):FireClient(player, {
			text = "Picked up by " .. triggerer.DisplayName,
			color = { 150, 255, 150 },
		})
	end)
end

local function enterDowned(player)
	local entry = ensure(player)
	if entry.downed or entry.out then return end
	entry.downed = true
	entry.downs = entry.downs + 1
	entry.bleedEnd = os.clock() + GameConfig.BleedOutTime
	player:SetAttribute("Downed", true)

	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.Health = math.max(1, math.floor(humanoid.MaxHealth * 0.08))
		humanoid.WalkSpeed = 0
		humanoid.UseJumpPower = true
		humanoid.JumpPower = 0
		humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)
		humanoid.Sit = false
	end

	if S.Loadout then
		S.Loadout.setSuppressed(player, true)
	end

	buildRevivePrompt(player)
	pushDowned(player)
	Net.get("Announce"):FireAllClients({
		title = player.DisplayName .. " IS DOWN",
		subtitle = "Hold F nearby to pick them up",
		color = { 255, 160, 60 },
		duration = 2.5,
	})
	checkWipe()
end

-- Central damage entry point for anything that hurts a player.
function PlayerService.damage(player, amount, sourceName)
	local entry = ensure(player)
	if entry.out then return end
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then return end

	entry.lastDamage = os.clock()

	if entry.downed then
		-- already down: chip the bleed-out timer instead of killing outright
		entry.bleedEnd = entry.bleedEnd - amount * 0.05
		pushDowned(player)
		return
	end

	local newHealth = humanoid.Health - amount
	if newHealth <= 0 then
		enterDowned(player)
	else
		humanoid.Health = newHealth
	end
	Net.get("Hitmarker"):FireClient(player, { taken = true, amount = amount, source = sourceName })
end

function PlayerService.healAll()
	for _, player in ipairs(Players:GetPlayers()) do
		local entry = ensure(player)
		if entry.downed then
			PlayerService.reviveTo(player, 1)
		elseif not entry.out then
			local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
			if humanoid and humanoid.Health > 0 then
				humanoid.Health = humanoid.MaxHealth
			end
		end
	end
end

-- Called by WaveService when a new wave begins: everyone who bled out comes back.
function PlayerService.onWaveStart()
	for _, player in ipairs(Players:GetPlayers()) do
		local entry = ensure(player)
		entry.selfReviveUsed = false
		if entry.out then
			entry.out = false
			entry.downed = false
			player:SetAttribute("Downed", false)
			player:LoadCharacter()
			pushDowned(player)
		end
	end
end

function PlayerService.resetForNewRun()
	for _, player in ipairs(Players:GetPlayers()) do
		local entry = ensure(player)
		entry.tonics = {}
		entry.agg = nil
		entry.downed = false
		entry.out = false
		entry.selfReviveUsed = false
		entry.bleedEnd = 0
		player:SetAttribute("Downed", false)
		removePrompt(player)
		PlayerService.pushTonics(player)
		pushDowned(player)
		player:LoadCharacter()
	end
end

function PlayerService.snapshot(player)
	local entry = ensure(player)
	local list = {}
	for id, has in pairs(entry.tonics) do
		if has then table.insert(list, id) end
	end
	return {
		tonics = list,
		downed = entry.downed,
		out = entry.out,
		bleedRemaining = math.max(0, entry.bleedEnd - os.clock()),
		bleedTotal = GameConfig.BleedOutTime,
	}
end

function PlayerService.init(services)
	S = services

	local function onCharacter(player, character)
		local entry = ensure(player)
		local humanoid = character:WaitForChild("Humanoid", 10)
		if not humanoid then return end
		humanoid.BreakJointsOnDeath = false
		entry.downed = false
		entry.bleedEnd = 0
		player:SetAttribute("Downed", entry.out)
		removePrompt(player)
		applyBody(player)

		local map = S.Map
		if map and map.playerSpawn then
			local root = character:WaitForChild("HumanoidRootPart", 5)
			if root then
				local angle = math.random() * math.pi * 2
				root.CFrame = CFrame.new(map.playerSpawn + Vector3.new(math.cos(angle) * 8, 0, math.sin(angle) * 8))
			end
		end

		if S.Loadout then
			S.Loadout.onCharacter(player, character)
		end

		humanoid.Died:Connect(function()
			local e = ensure(player)
			if not e.out then
				e.out = true
				e.downed = false
				player:SetAttribute("Downed", true)
				removePrompt(player)
				pushDowned(player)
				checkWipe()
			end
		end)
	end

	local function onPlayer(player)
		ensure(player)
		PlayerService.pushTonics(player)
		player.CharacterAdded:Connect(function(character)
			onCharacter(player, character)
		end)
		if player.Character then
			onCharacter(player, player.Character)
		else
			-- CharacterAutoLoads is off, so we spawn people in ourselves
			player:LoadCharacter()
		end
	end

	for _, player in ipairs(Players:GetPlayers()) do
		onPlayer(player)
	end
	Players.PlayerAdded:Connect(onPlayer)
	Players.PlayerRemoving:Connect(function(player)
		state[player] = nil
		task.defer(checkWipe)
	end)

	-- regen + bleed-out ticker
	local accumulator = 0
	heartbeatConn = RunService.Heartbeat:Connect(function(dt)
		accumulator = accumulator + dt
		if accumulator < 0.25 then return end
		local step = accumulator
		accumulator = 0
		local now = os.clock()
		for _, player in ipairs(Players:GetPlayers()) do
			local entry = state[player]
			if entry then
				if entry.downed then
					if now >= entry.bleedEnd then
						setOut(player)
					end
				elseif not entry.out then
					local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
					if humanoid and humanoid.Health > 0 and humanoid.Health < humanoid.MaxHealth then
						if now - entry.lastDamage >= GameConfig.RegenDelay then
							humanoid.Health = math.min(humanoid.MaxHealth, humanoid.Health + GameConfig.RegenRate * step)
						end
					end
				end
			end
		end
	end)
end

function PlayerService.shutdown()
	if heartbeatConn then
		heartbeatConn:Disconnect()
		heartbeatConn = nil
	end
end

return PlayerService
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX18">
				<Properties>
					<string name="Name">PowerupService</string>
					<ProtectedString name="Source"><![CDATA[-- PowerupService: the glowing pickups the horde drops. Effects are team-wide,
-- which is what makes them worth shouting about.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("NecrotideShared")
local GameConfig = require(Shared.GameConfig)
local PowerupDefs = require(Shared.PowerupDefs)
local Util = require(Shared.Util)
local Net = require(Shared.Net)

local PowerupService = {}
local S

local active = {}
local droppedThisWave = 0
local rng = Random.new(os.clock() * 1531)
local heartbeatConn
local timers = {}

local function announce(def, collector)
	Net.get("PowerupFx"):FireAllClients({
		id = def.id,
		name = def.name,
		blurb = def.blurb,
		color = { def.color.R * 255, def.color.G * 255, def.color.B * 255 },
		by = collector and collector.DisplayName or nil,
	})
end

local function clearTimer(key)
	if timers[key] then
		task.cancel(timers[key])
		timers[key] = nil
	end
end

local effects = {}

effects.purge = function(collector)
	local killed = S.EnemyService.purge(collector)
	for _, player in ipairs(Players:GetPlayers()) do
		S.Economy.add(player, 400, true)
	end
	return killed .. " erased"
end

effects.resupply = function()
	S.Loadout.maxAmmoEveryone()
	return "ammo restored"
end

effects.culling = function(_, duration)
	S.EnemyService.setInstakill(true)
	clearTimer("culling")
	timers.culling = task.delay(duration, function()
		S.EnemyService.setInstakill(false)
		timers.culling = nil
		Net.get("Notify"):FireAllClients({ text = "Culling Hour is over", color = { 255, 160, 160 } })
	end)
	return "one touch kills"
end

effects.surge = function(_, duration)
	S.Economy.setGlobalMultiplier(2)
	clearTimer("surge")
	timers.surge = task.delay(duration, function()
		S.Economy.setGlobalMultiplier(1)
		timers.surge = nil
		Net.get("Notify"):FireAllClients({ text = "Salvage Surge is over", color = { 160, 255, 160 } })
	end)
	return "double salvage"
end

effects.mend = function()
	S.PlayerService.healAll()
	return "squad restored"
end

local function collect(entry, player)
	if entry.taken then return end
	entry.taken = true
	if entry.part then
		entry.part:Destroy()
	end
	local def = entry.def
	local handler = effects[def.id]
	if handler then
		handler(player, def.duration)
	end
	announce(def, player)
end

local function buildPickup(def, position)
	local part = Instance.new("Part")
	part.Name = "Powerup_" .. def.id
	part.Size = Vector3.new(2.6, 2.6, 2.6)
	part.Position = position + Vector3.new(0, 3.2, 0)
	part.Anchored = true
	part.CanCollide = false
	part.Material = Enum.Material.Neon
	part.Color = def.color
	part.Parent = S.Map.fxFolder

	local light = Instance.new("PointLight")
	light.Color = def.color
	light.Brightness = 4
	light.Range = 26
	light.Parent = part

	local beam = Instance.new("Part")
	beam.Name = "Beam"
	beam.Size = Vector3.new(1.2, 40, 1.2)
	beam.Position = position + Vector3.new(0, 20, 0)
	beam.Anchored = true
	beam.CanCollide = false
	beam.Material = Enum.Material.Neon
	beam.Color = def.color
	beam.Transparency = 0.7
	beam.Parent = part

	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.new(10, 0, 2, 0)
	gui.StudsOffsetWorldSpace = Vector3.new(0, 3, 0)
	gui.AlwaysOnTop = true
	gui.MaxDistance = 250
	gui.Parent = part

	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBlack
	label.TextScaled = true
	label.TextColor3 = def.color
	label.TextStrokeTransparency = 0.2
	label.Text = def.name
	label.Parent = gui

	return part
end

function PowerupService.maybeDrop(position)
	if droppedThisWave >= GameConfig.PowerupMaxPerWave then return end
	if rng:NextNumber() > GameConfig.PowerupDropChance then return end
	PowerupService.forceDrop(position)
end

function PowerupService.forceDrop(position)
	local id = Util.weightedPick(PowerupDefs.pool(), rng)
	local def = PowerupDefs.get(id)
	if not def then return end
	droppedThisWave = droppedThisWave + 1

	local part = buildPickup(def, position)
	local entry = {
		def = def,
		part = part,
		expiresAt = os.clock() + GameConfig.PowerupLifetime,
		taken = false,
		basePosition = part.Position,
	}
	table.insert(active, entry)
end

function PowerupService.onWaveStart()
	droppedThisWave = 0
end

function PowerupService.resetForNewRun()
	for _, entry in ipairs(active) do
		if entry.part then entry.part:Destroy() end
		entry.taken = true
	end
	active = {}
	droppedThisWave = 0
	S.EnemyService.setInstakill(false)
	S.Economy.setGlobalMultiplier(1)
	clearTimer("culling")
	clearTimer("surge")
end

function PowerupService.init(services)
	S = services

	local spin = 0
	heartbeatConn = RunService.Heartbeat:Connect(function(dt)
		if #active == 0 then return end
		spin = spin + dt
		local now = os.clock()
		for index = #active, 1, -1 do
			local entry = active[index]
			if entry.taken then
				table.remove(active, index)
			elseif now >= entry.expiresAt then
				entry.taken = true
				if entry.part then entry.part:Destroy() end
				table.remove(active, index)
			else
				if entry.part then
					local bobY = math.sin(spin * 2.6) * 0.5
					entry.part.CFrame = CFrame.new(entry.basePosition + Vector3.new(0, bobY, 0))
						* CFrame.Angles(math.rad(spin * 60), math.rad(spin * 90), 0)
					-- fade out in the last three seconds
					if entry.expiresAt - now < 3 then
						entry.part.Transparency = 0.5 + math.sin(now * 20) * 0.35
					end
				end
				for _, target in ipairs(Util.activeTargets()) do
					if (target.root.Position - entry.basePosition).Magnitude < 7 then
						collect(entry, target.player)
						break
					end
				end
			end
		end
	end)
end

function PowerupService.shutdown()
	if heartbeatConn then
		heartbeatConn:Disconnect()
		heartbeatConn = nil
	end
end

return PowerupService
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX19">
				<Properties>
					<string name="Name">StationService</string>
					<ProtectedString name="Source"><![CDATA[-- StationService: everything you can walk up to and spend salvage on.
--   * Armory Racks   - wall weapons and ammo restocks
--   * The Fate Crate - random weapon roulette that sometimes packs up and moves
--   * The Overforge  - upgrades the weapon in your hands into its forged form
--   * Tonic Stills   - permanent buffs

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local Shared = ReplicatedStorage:WaitForChild("NecrotideShared")
local GameConfig = require(Shared.GameConfig)
local WeaponDefs = require(Shared.WeaponDefs)
local TonicDefs = require(Shared.TonicDefs)
local Util = require(Shared.Util)
local Net = require(Shared.Net)

local StationService = {}
local S

local rng = Random.new(os.clock() * 4241)
local crate = {
	model = nil,
	spotIndex = 1,
	busy = false,
	uses = 0,
}
local forge = { model = nil, busy = false }

--------------------------------------------------------------------------------
-- shared building blocks
--------------------------------------------------------------------------------

local function newPart(parent, name, size, position, color, material)
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.Position = position
	part.Color = color
	part.Material = material or Enum.Material.Metal
	part.Anchored = true
	part.CanCollide = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = parent
	return part
end

local function labelOn(part, title, subtitle, color, offsetY)
	local gui = Instance.new("BillboardGui")
	gui.Name = "StationLabel"
	gui.Size = UDim2.new(11, 0, 3.2, 0)
	gui.StudsOffsetWorldSpace = Vector3.new(0, offsetY or 4, 0)
	gui.AlwaysOnTop = false
	gui.MaxDistance = 140
	gui.Parent = part

	local holder = Instance.new("Frame")
	holder.Size = UDim2.fromScale(1, 1)
	holder.BackgroundTransparency = 1
	holder.Parent = gui

	local name = Instance.new("TextLabel")
	name.Size = UDim2.new(1, 0, 0.58, 0)
	name.BackgroundTransparency = 1
	name.Font = Enum.Font.GothamBlack
	name.TextScaled = true
	name.TextColor3 = color or Color3.fromRGB(255, 220, 160)
	name.TextStrokeTransparency = 0.3
	name.Text = title
	name.Name = "Title"
	name.Parent = holder

	local sub = Instance.new("TextLabel")
	sub.Size = UDim2.new(1, 0, 0.42, 0)
	sub.Position = UDim2.new(0, 0, 0.58, 0)
	sub.BackgroundTransparency = 1
	sub.Font = Enum.Font.GothamSemibold
	sub.TextScaled = true
	sub.TextColor3 = Color3.fromRGB(235, 235, 235)
	sub.TextStrokeTransparency = 0.5
	sub.Text = subtitle or ""
	sub.Name = "Subtitle"
	sub.Parent = holder

	return gui
end

local function addPrompt(part, actionText, objectText, holdDuration, distance)
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = actionText
	prompt.ObjectText = objectText
	prompt.HoldDuration = holdDuration or 0
	prompt.MaxActivationDistance = distance or 11
	prompt.RequiresLineOfSight = false
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.Parent = part
	return prompt
end

local function canInteract(player)
	if S.PlayerService.isDowned(player) or S.PlayerService.isOut(player) then
		return false
	end
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	return humanoid ~= nil and humanoid.Health > 0
end

local function denied(player, text)
	Net.get("Notify"):FireClient(player, { text = text, color = { 255, 110, 110 } })
end

local function granted(player, text)
	Net.get("Notify"):FireClient(player, { text = text, color = { 150, 255, 170 } })
end

--------------------------------------------------------------------------------
-- armory racks (wall buys)
--------------------------------------------------------------------------------

local function buildWallBuy(spec)
	local def = WeaponDefs.get(spec.weapon)
	if not def then return end
	if not def.wallCost then
		warn("[Necrotide] " .. def.name .. " has no wallCost, so it cannot go on an Armory Rack")
		return
	end
	local folder = Instance.new("Model")
	folder.Name = "ArmoryRack_" .. def.id
	folder.Parent = S.Map.stationFolder

	local facing = spec.face
	local isXAxis = math.abs(facing.X) > 0.5
	local plateSize = isXAxis and Vector3.new(0.6, 5, 7) or Vector3.new(7, 5, 0.6)
	local plate = newPart(folder, "Plate", plateSize, spec.pos, Color3.fromRGB(46, 44, 42), Enum.Material.DiamondPlate)

	-- a chalk outline of the weapon on the wall
	local outlineSize = isXAxis and Vector3.new(0.3, 0.7, def.body.length) or Vector3.new(def.body.length, 0.7, 0.3)
	local outline = newPart(folder, "Outline", outlineSize, spec.pos + facing * 0.5, def.body.color, Enum.Material.SmoothPlastic)
	outline.CanCollide = false

	local ammoCost = math.floor((def.wallCost or 3000) * GameConfig.AmmoRefillCostRatio)
	labelOn(plate, def.name, "BUY " .. def.wallCost .. "   AMMO " .. ammoCost, Color3.fromRGB(255, 225, 170), 4)

	local prompt = addPrompt(plate, "Buy " .. def.name .. " [" .. def.wallCost .. "]", "ARMORY RACK", 0.25, 12)
	prompt.Triggered:Connect(function(player)
		if not canInteract(player) then return end
		local owned = S.Loadout.has(player, def.id)
		if owned then
			if not S.Economy.spend(player, ammoCost) then
				denied(player, "Need " .. ammoCost .. " salvage for ammo")
				return
			end
			S.Loadout.refillWeapon(player, def.id)
			granted(player, def.name .. " restocked")
		else
			if not S.Economy.spend(player, def.wallCost) then
				denied(player, "Need " .. def.wallCost .. " salvage")
				return
			end
			S.Loadout.give(player, def.id, false)
			granted(player, "Picked up " .. def.name)
		end
	end)
end

--------------------------------------------------------------------------------
-- the fate crate
--------------------------------------------------------------------------------

local function destroyCrate()
	if crate.model then
		crate.model:Destroy()
		crate.model = nil
	end
end

local function buildCrate(spotIndex)
	destroyCrate()
	crate.spotIndex = spotIndex
	local pos = S.Map.cratePositions[spotIndex]

	local model = Instance.new("Model")
	model.Name = "FateCrate"
	model.Parent = S.Map.stationFolder

	local base = newPart(model, "Base", Vector3.new(8, 4, 6), pos + Vector3.new(0, 2, 0), Color3.fromRGB(92, 66, 40), Enum.Material.WoodPlanks)
	local lid = newPart(model, "Lid", Vector3.new(8.4, 0.8, 6.4), pos + Vector3.new(0, 4.4, 0), Color3.fromRGB(66, 48, 30), Enum.Material.WoodPlanks)
	local glow = newPart(model, "Glow", Vector3.new(7.2, 0.4, 5.2), pos + Vector3.new(0, 4.1, 0), Color3.fromRGB(255, 190, 90), Enum.Material.Neon)
	glow.CanCollide = false

	for _, side in ipairs({ -1, 1 }) do
		local band = newPart(model, "Band", Vector3.new(8.3, 0.5, 6.3), pos + Vector3.new(0, 2 + side * 1.2, 0), Color3.fromRGB(40, 38, 36), Enum.Material.Metal)
		band.CanCollide = false
	end

	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 190, 110)
	light.Brightness = 3
	light.Range = 34
	light.Parent = glow

	local beacon = newPart(model, "Beacon", Vector3.new(1.2, 26, 1.2), pos + Vector3.new(0, 15, 0), Color3.fromRGB(255, 200, 120), Enum.Material.Neon)
	beacon.CanCollide = false
	beacon.Transparency = 0.55

	labelOn(lid, "THE FATE CRATE", GameConfig.CrateBaseCost .. " SALVAGE", Color3.fromRGB(255, 205, 120), 4)

	local display = Instance.new("Part")
	display.Name = "Display"
	display.Size = Vector3.new(2, 0.6, 0.6)
	display.Position = pos + Vector3.new(0, 7.5, 0)
	display.Anchored = true
	display.CanCollide = false
	display.Transparency = 1
	display.Parent = model

	local prompt = addPrompt(lid, "Open the Fate Crate [" .. GameConfig.CrateBaseCost .. "]", "FATE CRATE", 0.3, 12)
	prompt.Triggered:Connect(function(player)
		StationService.useCrate(player)
	end)

	crate.model = model
	crate.prompt = prompt
	crate.lid = lid
	crate.display = display
	crate.position = pos
end

local function relocateCrate()
	local from = crate.spotIndex
	local choices = {}
	for index = 1, #S.Map.cratePositions do
		if index ~= from then
			table.insert(choices, index)
		end
	end
	local target = choices[rng:NextInteger(1, #choices)]

	-- a puff where it was, a beam where it went
	local oldPos = crate.position
	destroyCrate()
	local puff = Instance.new("Part")
	puff.Size = Vector3.new(6, 6, 6)
	puff.Position = oldPos + Vector3.new(0, 3, 0)
	puff.Anchored = true
	puff.CanCollide = false
	puff.Transparency = 0.4
	puff.Material = Enum.Material.Neon
	puff.Color = Color3.fromRGB(180, 140, 255)
	puff.Parent = S.Map.fxFolder
	TweenService:Create(puff, TweenInfo.new(0.6), { Size = Vector3.new(18, 18, 18), Transparency = 1 }):Play()
	Debris:AddItem(puff, 1)

	crate.uses = 0
	buildCrate(target)
	Net.get("Announce"):FireAllClients({
		title = "THE FATE CRATE HAS MOVED",
		subtitle = "The Hollow Doll took it elsewhere",
		color = { 200, 150, 255 },
		duration = 3.5,
	})
end

function StationService.useCrate(player)
	if not canInteract(player) then return end
	if crate.busy then
		denied(player, "The crate is already spinning")
		return
	end
	if not S.Economy.spend(player, GameConfig.CrateBaseCost) then
		denied(player, "Need " .. GameConfig.CrateBaseCost .. " salvage")
		return
	end

	crate.busy = true
	crate.uses = crate.uses + 1

	local doll = rng:NextNumber() < GameConfig.CrateRelocateChance or crate.uses >= GameConfig.CrateForcedMoveUses
	local pool = WeaponDefs.cratePool()
	local resultId = Util.weightedPick(pool, rng)
	local resultDef = WeaponDefs.get(resultId)

	-- reel of names for the client-side roulette
	local reel = {}
	for _ = 1, 14 do
		local id = Util.weightedPick(pool, rng)
		local def = WeaponDefs.get(id)
		table.insert(reel, def and def.name or "???")
	end
	table.insert(reel, resultDef and resultDef.name or "???")

	if crate.lid then
		TweenService:Create(crate.lid, TweenInfo.new(0.4, Enum.EasingStyle.Back), {
			CFrame = crate.lid.CFrame * CFrame.new(0, 1.6, -2) * CFrame.Angles(math.rad(-70), 0, 0),
		}):Play()
	end

	Net.get("CrateSpin"):FireAllClients({
		position = crate.position,
		duration = GameConfig.CrateSpinTime,
		reel = reel,
		result = doll and "THE HOLLOW DOLL" or (resultDef and resultDef.name or "???"),
		doll = doll,
		buyer = player,
	})

	task.delay(GameConfig.CrateSpinTime, function()
		if doll then
			crate.busy = false
			relocateCrate()
			denied(player, "The Hollow Doll grins. The crate is gone.")
			return
		end
		if player.Parent and resultId then
			S.Loadout.give(player, resultId, false)
			granted(player, "The crate gave you " .. resultDef.name)
		end
		if crate.lid then
			TweenService:Create(crate.lid, TweenInfo.new(0.5, Enum.EasingStyle.Quad), {
				CFrame = CFrame.new(crate.position + Vector3.new(0, 4.4, 0)),
			}):Play()
		end
		crate.busy = false
	end)
end

--------------------------------------------------------------------------------
-- the overforge
--------------------------------------------------------------------------------

local function buildForge()
	local pos = S.Map.forgePosition
	local model = Instance.new("Model")
	model.Name = "Overforge"
	model.Parent = S.Map.stationFolder

	newPart(model, "Base", Vector3.new(12, 2, 10), pos + Vector3.new(0, 1, 0), Color3.fromRGB(48, 44, 42), Enum.Material.DiamondPlate)
	local column = newPart(model, "Column", Vector3.new(9, 12, 7), pos + Vector3.new(0, 8, 0), Color3.fromRGB(62, 54, 50), Enum.Material.CorrodedMetal)
	local maw = newPart(model, "Maw", Vector3.new(6, 5, 1), pos + Vector3.new(0, 7, -3.6), Color3.fromRGB(255, 120, 40), Enum.Material.Neon)
	maw.CanCollide = false

	for _, side in ipairs({ -1, 1 }) do
		local pipe = newPart(model, "Pipe", Vector3.new(1.4, 14, 1.4), pos + Vector3.new(side * 5.4, 9, 2.6), Color3.fromRGB(40, 38, 36), Enum.Material.CorrodedMetal)
		pipe.CanCollide = false
	end

	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 130, 50)
	light.Brightness = 4
	light.Range = 42
	light.Parent = maw

	local fire = Instance.new("Fire")
	fire.Size = 10
	fire.Heat = 8
	fire.Color = Color3.fromRGB(255, 140, 50)
	fire.Parent = maw

	labelOn(column, "THE OVERFORGE", GameConfig.ForgeCost .. " SALVAGE  -  UPGRADE HELD WEAPON", Color3.fromRGB(255, 150, 70), 8)

	local prompt = addPrompt(column, "Overforge weapon [" .. GameConfig.ForgeCost .. "]", "OVERFORGE", 0.35, 13)
	prompt.Triggered:Connect(function(player)
		StationService.useForge(player)
	end)

	forge.model = model
	forge.maw = maw
end

function StationService.useForge(player)
	if not canInteract(player) then return end
	if forge.busy then
		denied(player, "The Overforge is already working")
		return
	end
	local held = S.Loadout.active(player)
	if not held then
		denied(player, "Nothing in your hands")
		return
	end
	if held.upgraded then
		denied(player, held.name .. " is already forged")
		return
	end
	if not S.Economy.spend(player, GameConfig.ForgeCost) then
		denied(player, "Need " .. GameConfig.ForgeCost .. " salvage")
		return
	end

	forge.busy = true
	local slotIndex = select(2, S.Loadout.has(player, held.id))
	local weaponId = held.id

	if forge.maw then
		TweenService:Create(forge.maw, TweenInfo.new(GameConfig.ForgeTime * 0.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, 1, true), {
			Size = Vector3.new(7.5, 6.5, 1),
			Color = Color3.fromRGB(255, 235, 180),
		}):Play()
	end

	Net.get("Notify"):FireClient(player, { text = "Forging " .. held.name .. "...", color = { 255, 170, 90 } })

	task.delay(GameConfig.ForgeTime, function()
		forge.busy = false
		if not player.Parent then return end
		local ok, newName = S.Loadout.upgradeSlot(player, slotIndex, weaponId)
		if ok then
			granted(player, "FORGED: " .. newName)
			Net.get("Announce"):FireAllClients({
				title = "OVERFORGED",
				subtitle = player.DisplayName .. " now carries the " .. newName,
				color = { 255, 160, 70 },
				duration = 3,
			})
		else
			-- the weapon left the slot mid-forge: refund rather than eat the salvage
			S.Economy.add(player, GameConfig.ForgeCost, true)
			denied(player, "Forge failed, salvage refunded")
		end
	end)
end

--------------------------------------------------------------------------------
-- tonic stills
--------------------------------------------------------------------------------

local function buildTonic(spec)
	local def = TonicDefs.get(spec.tonic)
	if not def then return end
	local pos = spec.pos

	local model = Instance.new("Model")
	model.Name = "TonicStill_" .. def.id
	model.Parent = S.Map.stationFolder

	newPart(model, "Base", Vector3.new(6, 1.5, 5), pos + Vector3.new(0, 0.75, 0), Color3.fromRGB(44, 42, 40), Enum.Material.DiamondPlate)
	local cabinet = newPart(model, "Cabinet", Vector3.new(5, 8, 4), pos + Vector3.new(0, 5.5, 0), Color3.fromRGB(58, 56, 54), Enum.Material.Metal)
	local tank = newPart(model, "Tank", Vector3.new(2.4, 5, 2.4), pos + Vector3.new(0, 6, -2.2), def.color, Enum.Material.Neon)
	tank.CanCollide = false
	tank.Transparency = 0.25

	local light = Instance.new("PointLight")
	light.Color = def.color
	light.Brightness = 2.4
	light.Range = 26
	light.Parent = tank

	labelOn(cabinet, def.name, def.blurb .. "  -  " .. def.cost, def.color, 6)

	local prompt = addPrompt(cabinet, "Drink " .. def.name .. " [" .. def.cost .. "]", "TONIC STILL", 0.3, 11)
	prompt.Triggered:Connect(function(player)
		if not canInteract(player) then return end
		if S.PlayerService.hasTonic(player, def.id) then
			denied(player, "Already coursing through you")
			return
		end
		if not S.Economy.spend(player, def.cost) then
			denied(player, "Need " .. def.cost .. " salvage")
			return
		end
		S.PlayerService.grantTonic(player, def.id)
		granted(player, def.name .. " - " .. def.blurb)
	end)
end

--------------------------------------------------------------------------------
-- lifecycle
--------------------------------------------------------------------------------

function StationService.resetForNewRun()
	crate.uses = 0
	crate.busy = false
	forge.busy = false
	buildCrate(rng:NextInteger(1, #S.Map.cratePositions))
end

function StationService.init(services)
	S = services

	for _, spec in ipairs(S.Map.wallBuys) do
		buildWallBuy(spec)
	end
	for _, spec in ipairs(S.Map.tonicSpots) do
		buildTonic(spec)
	end
	buildForge()
	buildCrate(rng:NextInteger(1, #S.Map.cratePositions))
end

return StationService
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX20">
				<Properties>
					<string name="Name">WaveService</string>
					<ProtectedString name="Source"><![CDATA[-- WaveService: the round director. Owns the intermission timer, the spawn budget,
-- the boss schedule, victory and the post-wipe reset.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("NecrotideShared")
local GameConfig = require(Shared.GameConfig)
local EnemyDefs = require(Shared.EnemyDefs)
local Util = require(Shared.Util)
local Net = require(Shared.Net)

local WaveService = {}
local S

local rng = Random.new(os.clock() * 977)

local wave = 0
local phase = "lobby" -- lobby | intermission | active | ended
local phaseEndsAt = 0
local pendingSpawns = 0
local waveKills = 0
local waveTotal = 0
local running = false
local runToken = 0
local victoryReached = false

local function serverNow()
	return workspace:GetServerTimeNow()
end

local function broadcast()
	Net.get("WaveChanged"):FireAllClients({
		wave = wave,
		phase = phase,
		endsAt = phaseEndsAt,
		remaining = math.max(0, pendingSpawns + S.EnemyService.aliveCount()),
		total = waveTotal,
		finalWave = GameConfig.FinalBossWave,
		isBossWave = wave > 0 and EnemyDefs.bossForWave(wave, GameConfig.FinalBossWave, GameConfig.BossWaveInterval) ~= nil,
	})
end

function WaveService.snapshot()
	return {
		wave = wave,
		phase = phase,
		endsAt = phaseEndsAt,
		remaining = math.max(0, pendingSpawns + S.EnemyService.aliveCount()),
		total = waveTotal,
		finalWave = GameConfig.FinalBossWave,
	}
end

local function quotaFor(waveNumber, playerCount)
	local base = GameConfig.EnemyBaseCount + GameConfig.EnemyCountPerWave * (waveNumber - 1)
	local scaled = base * (1 + GameConfig.EnemyCountPerExtraPlayer * math.max(0, playerCount - 1))
	return math.min(GameConfig.EnemyCountCap, math.floor(scaled))
end

-- Prefers spawn points near the squad so waves feel like pressure, not a hike.
local function pickSpawn()
	local points = S.Map.spawnPoints
	local targets = Util.activeTargets()
	if #targets == 0 then
		return points[rng:NextInteger(1, #points)]
	end

	local near = {}
	for _, point in ipairs(points) do
		for _, target in ipairs(targets) do
			if (Vector3.new(point.barrier.inside.X, 0, point.barrier.inside.Z) - Vector3.new(target.root.Position.X, 0, target.root.Position.Z)).Magnitude < 150 then
				table.insert(near, point)
				break
			end
		end
	end
	if #near > 0 then
		return near[rng:NextInteger(1, #near)]
	end
	return points[rng:NextInteger(1, #points)]
end

local function spawnOne(waveNumber)
	local pool = EnemyDefs.poolForWave(waveNumber)
	local id = Util.weightedPick(pool, rng)
	if not id then return false end
	local point = pickSpawn()
	if not point then return false end
	local jitter = Util.randomFlatOffset(6)
	local entity = S.EnemyService.spawn(id, waveNumber, point.position + jitter, { barrier = point.barrier })
	return entity ~= nil
end

local function spawnBoss(bossDef, waveNumber)
	local point = pickSpawn()
	local position = point and point.position or Vector3.new(0, 0, -100)
	local entity = S.EnemyService.spawn(bossDef.id, waveNumber, position, { barrier = point and point.barrier })
	if entity then
		Net.get("Announce"):FireAllClients({
			title = bossDef.name,
			subtitle = bossDef.title,
			color = { bossDef.colors.glow.R * 255, bossDef.colors.glow.G * 255, bossDef.colors.glow.B * 255 },
			duration = 4.5,
			big = true,
		})
	end
	return entity
end

function WaveService.onEnemyRemoved()
	waveKills = waveKills + 1
	broadcast()
end

local function waitPhase(duration, token)
	phaseEndsAt = serverNow() + duration
	broadcast()
	local deadline = os.clock() + duration
	while os.clock() < deadline do
		if token ~= runToken then return false end
		task.wait(0.25)
		broadcast()
	end
	return token == runToken
end

local function runWave(waveNumber, token)
	local playerCount = math.max(1, #Players:GetPlayers())
	local bossDef = EnemyDefs.bossForWave(waveNumber, GameConfig.FinalBossWave, GameConfig.BossWaveInterval)

	waveKills = 0
	pendingSpawns = quotaFor(waveNumber, playerCount)
	if bossDef then
		-- boss waves come with a smaller escort so the fight stays readable
		pendingSpawns = math.floor(pendingSpawns * 0.55)
	end
	waveTotal = pendingSpawns + (bossDef and 1 or 0)
	phase = "active"
	phaseEndsAt = 0

	S.PlayerService.onWaveStart()
	S.PowerupService.onWaveStart()
	broadcast()

	Net.get("Announce"):FireAllClients({
		title = "WAVE " .. waveNumber,
		subtitle = bossDef and ("BOSS: " .. bossDef.name) or (waveTotal .. " incoming"),
		color = bossDef and { 255, 90, 90 } or { 255, 220, 160 },
		duration = 2.6,
		big = bossDef ~= nil,
	})

	if bossDef then
		task.delay(2.2, function()
			if token == runToken then
				spawnBoss(bossDef, waveNumber)
			end
		end)
	end

	while running and token == runToken do
		if pendingSpawns > 0 and S.EnemyService.aliveCount() < GameConfig.MaxAliveEnemies then
			if spawnOne(waveNumber) then
				pendingSpawns = pendingSpawns - 1
				broadcast()
			end
			task.wait(math.max(0.15, GameConfig.SpawnInterval - waveNumber * 0.015))
		elseif pendingSpawns <= 0 and S.EnemyService.aliveCount() == 0 then
			break
		else
			task.wait(0.25)
		end
	end

	if token ~= runToken then return false end

	local bonus = GameConfig.WaveClearBonus * waveNumber
	for _, player in ipairs(Players:GetPlayers()) do
		S.Economy.add(player, bonus, true)
	end
	Net.get("Announce"):FireAllClients({
		title = "WAVE " .. waveNumber .. " CLEARED",
		subtitle = "+" .. bonus .. " salvage",
		color = { 160, 255, 180 },
		duration = 2.4,
	})
	return true
end

local function victory(token)
	victoryReached = true
	phase = "ended"
	broadcast()
	Net.get("RunEnded"):FireAllClients({
		victory = true,
		wave = wave,
		title = "THE HOLLOW SOVEREIGN FALLS",
		subtitle = GameConfig.EndlessAfterVictory
			and "The Ashvault holds. Endless waves begin shortly."
			or "The Ashvault holds.",
	})
	task.wait(8)
	if token ~= runToken then return end
	if not GameConfig.EndlessAfterVictory then
		WaveService.endRun(true, true)
	end
end

local function loop(token)
	while running and token == runToken do
		phase = wave == 0 and "lobby" or "intermission"
		local duration = wave == 0 and GameConfig.IntermissionFirst or GameConfig.IntermissionBetween
		Net.get("Announce"):FireAllClients({
			title = wave == 0 and "THE ASHVAULT" or ("WAVE " .. (wave + 1) .. " INBOUND"),
			subtitle = wave == 0 and "Board the gaps. Spend your salvage. Survive." or "Restock and repair",
			color = { 220, 220, 235 },
			duration = 3,
		})
		if not waitPhase(duration, token) then return end

		wave = wave + 1
		local completed = runWave(wave, token)
		if not completed then return end

		if wave == GameConfig.FinalBossWave and not victoryReached then
			victory(token)
			if not GameConfig.EndlessAfterVictory then
				return
			end
		end
	end
end

function WaveService.start()
	if running then return end
	running = true
	runToken = runToken + 1
	local token = runToken
	task.spawn(function()
		loop(token)
	end)
end

-- victory = finished the campaign, otherwise the squad wiped.
function WaveService.endRun(isVictory, skipRestart)
	if phase == "ended" and not isVictory then return end
	runToken = runToken + 1
	running = false
	phase = "ended"
	pendingSpawns = 0
	broadcast()

	S.EnemyService.clearAll()

	Net.get("RunEnded"):FireAllClients({
		victory = isVictory == true,
		wave = wave,
		title = isVictory and "THE ASHVAULT HOLDS" or "THE ASHVAULT HAS FALLEN",
		subtitle = isVictory and ("Cleared wave " .. wave) or ("You held until wave " .. wave .. ". Resetting..."),
	})

	if skipRestart then return end

	task.delay(GameConfig.RestartDelay, function()
		WaveService.reset()
	end)
end

function WaveService.reset()
	wave = 0
	phase = "lobby"
	pendingSpawns = 0
	waveTotal = 0
	waveKills = 0
	victoryReached = false

	S.EnemyService.clearAll()
	S.Economy.resetAll()
	S.PlayerService.resetForNewRun()
	S.Loadout.resetForNewRun()
	S.BarrierService.resetAll()
	S.StationService.resetForNewRun()
	S.PowerupService.resetForNewRun()

	broadcast()
	WaveService.start()
end

function WaveService.currentWave()
	return wave
end

function WaveService.init(services)
	S = services

	Players.PlayerAdded:Connect(function()
		task.defer(broadcast)
	end)
end

return WaveService
]]></ProtectedString>
				</Properties>
			</Item>
		</Item>
	</Item>
	<Item class="StarterPlayer" referent="RBX28">
		<Properties>
			<string name="Name">StarterPlayer</string>
		</Properties>
		<Item class="StarterPlayerScripts" referent="RBX27">
			<Properties>
				<string name="Name">StarterPlayerScripts</string>
			</Properties>
			<Item class="LocalScript" referent="RBX23">
				<Properties>
					<string name="Name">ClientMain</string>
					<ProtectedString name="Source"><![CDATA[-- ClientMain: input, aiming, and the bridge between the server's remotes and the
-- HUD. The client is deliberately powerless: it asks to shoot, reload and swap,
-- and it renders whatever the server tells it.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local StarterGui = game:GetService("StarterGui")

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local Shared = ReplicatedStorage:WaitForChild("NecrotideShared")
local Net = require(Shared.Net)

local Modules = script.Parent:WaitForChild("Modules")
local Hud = require(Modules:WaitForChild("Hud"))
local Effects = require(Modules:WaitForChild("Effects"))

local SPRINT_MULT = 1.35
local AIM_RANGE = 900

local firing = false
local lastFire = 0
local sprinting = false
local baseWalkSpeed = 16
local mouseLocked = true
local loadout = nil
local downed = false
local movementSpread = 0

if not Hud.build() then
	-- another copy of the client is already running for this player
	return
end

pcall(function()
	StarterGui:SetCore("TopbarEnabled", true)
end)

--------------------------------------------------------------------------------
-- helpers
--------------------------------------------------------------------------------

local function character()
	return player.Character
end

local function humanoid()
	local c = character()
	return c and c:FindFirstChildOfClass("Humanoid")
end

local function head()
	local c = character()
	return c and (c:FindFirstChild("Head") or c.PrimaryPart)
end

local function activeWeapon()
	if not loadout or not loadout.slots then return nil end
	return loadout.slots[loadout.active]
end

local aimParams = RaycastParams.new()
aimParams.FilterType = Enum.RaycastFilterType.Exclude
aimParams.IgnoreWater = true

local function refreshAimFilter()
	local filter = {}
	local c = character()
	if c then table.insert(filter, c) end
	local fx = camera:FindFirstChild("NecrotideClientFx")
	if fx then table.insert(filter, fx) end
	aimParams.FilterDescendantsInstances = filter
end

-- Where the centre of the screen is pointing, in world space.
local function aimPoint()
	local viewport = camera.ViewportSize
	local ray = camera:ViewportPointToRay(viewport.X * 0.5, viewport.Y * 0.5)
	local result = workspace:Raycast(ray.Origin, ray.Direction * AIM_RANGE, aimParams)
	if result then
		return result.Position
	end
	return ray.Origin + ray.Direction * AIM_RANGE
end

local function tryFire()
	local weapon = activeWeapon()
	if not weapon or downed then return end
	local h = head()
	if not h then return end
	local hum = humanoid()
	if not hum or hum.Health <= 0 then return end

	local interval = 60 / math.max(1, weapon.rpm)
	local now = os.clock()
	if now - lastFire < interval then return end
	lastFire = now

	local direction = (aimPoint() - h.Position)
	if direction.Magnitude < 0.01 then return end
	Net.get("FireRequest"):FireServer(direction.Unit, h.Position)

	Effects.addKick(weapon.class == "Shotgun" and 1.5 or 0.55)
	movementSpread = math.min(1, movementSpread + 0.22)
end

--------------------------------------------------------------------------------
-- remote wiring
--------------------------------------------------------------------------------

Net.get("EconomyChanged").OnClientEvent:Connect(Hud.setEconomy)
Net.get("WaveChanged").OnClientEvent:Connect(function(data)
	Hud.setWave(data)
	if data and data.phase ~= "ended" then
		Hud.hideEndPanel()
	end
end)
Net.get("Announce").OnClientEvent:Connect(Hud.announce)
Net.get("Notify").OnClientEvent:Connect(Hud.toast)
Net.get("BossState").OnClientEvent:Connect(Hud.setBoss)
Net.get("TonicsChanged").OnClientEvent:Connect(function(list)
	Hud.setTonics(list)
	Effects.play("pickup", 0.5, 1)
end)
Net.get("LoadoutChanged").OnClientEvent:Connect(function(data)
	loadout = data
	Hud.setLoadout(data)
end)
Net.get("Hitmarker").OnClientEvent:Connect(function(data)
	Hud.flashHitmarker(data)
	if data and data.hit then
		Effects.play("click", data.headshot and 0.5 or 0.3, data.headshot and 1.5 or 1.2)
	end
end)
Net.get("ShotFx").OnClientEvent:Connect(Effects.shot)
Net.get("CrateSpin").OnClientEvent:Connect(function(data)
	Hud.crateSpin(data)
	Effects.play("pickup", 0.4, 0.8)
end)
Net.get("PowerupFx").OnClientEvent:Connect(function(data)
	Hud.powerup(data)
	Effects.play("pickup", 0.7, 1.1)
end)
Net.get("DownedState").OnClientEvent:Connect(function(data)
	downed = data and (data.downed or data.out) or false
	Hud.setDowned(data)
	if downed then
		firing = false
		Effects.play("alarm", 0.45, 0.8)
	end
end)
Net.get("RunEnded").OnClientEvent:Connect(function(data)
	Hud.runEnded(data)
	Effects.play("alarm", 0.6, data and data.victory and 1.3 or 0.7)
end)

--------------------------------------------------------------------------------
-- input
--------------------------------------------------------------------------------

UserInputService.InputBegan:Connect(function(input, processed)
	if processed then return end
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		firing = true
		tryFire()
	elseif input.UserInputType == Enum.UserInputType.Touch then
		firing = true
		tryFire()
	elseif input.KeyCode == Enum.KeyCode.R then
		Net.get("ReloadRequest"):FireServer()
	elseif input.KeyCode == Enum.KeyCode.One then
		Net.get("SwapRequest"):FireServer(1)
	elseif input.KeyCode == Enum.KeyCode.Two then
		Net.get("SwapRequest"):FireServer(2)
	elseif input.KeyCode == Enum.KeyCode.Q then
		local other = (loadout and loadout.active == 1) and 2 or 1
		Net.get("SwapRequest"):FireServer(other)
	elseif input.KeyCode == Enum.KeyCode.H then
		Hud.toggleHelp()
	elseif input.KeyCode == Enum.KeyCode.LeftShift or input.KeyCode == Enum.KeyCode.RightShift then
		sprinting = true
	elseif input.KeyCode == Enum.KeyCode.LeftAlt then
		mouseLocked = not mouseLocked
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		firing = false
	elseif input.KeyCode == Enum.KeyCode.LeftShift or input.KeyCode == Enum.KeyCode.RightShift then
		sprinting = false
	end
end)

UserInputService.InputChanged:Connect(function(input, processed)
	if processed then return end
	if input.UserInputType == Enum.UserInputType.MouseWheel and loadout then
		local other = (loadout.active == 1) and 2 or 1
		Net.get("SwapRequest"):FireServer(other)
	end
end)

--------------------------------------------------------------------------------
-- per-frame
--------------------------------------------------------------------------------

player.CharacterAdded:Connect(function(newCharacter)
	local hum = newCharacter:WaitForChild("Humanoid", 10)
	if hum then
		baseWalkSpeed = hum.WalkSpeed
		hum.AutoRotate = false
	end
	task.defer(refreshAimFilter)
end)

if character() then
	local hum = humanoid()
	if hum then
		baseWalkSpeed = hum.WalkSpeed
		hum.AutoRotate = false
	end
	refreshAimFilter()
end

local filterRefresh = 0

RunService.RenderStepped:Connect(function(dt)
	filterRefresh = filterRefresh + dt
	if filterRefresh > 1.5 then
		filterRefresh = 0
		refreshAimFilter()
	end

	local hum = humanoid()
	local weapon = activeWeapon()

	-- sprint (PvE only, so letting the client own its own legs is harmless)
	if hum and hum.Health > 0 and not downed then
		local wanted = sprinting and baseWalkSpeed * SPRINT_MULT or baseWalkSpeed
		if math.abs(hum.WalkSpeed - wanted) > 0.1 and hum.WalkSpeed > 0 then
			hum.WalkSpeed = wanted
		end
	end

	-- mouse lock and shooter-style body facing
	local shouldLock = mouseLocked and not downed and hum ~= nil and hum.Health > 0
	if shouldLock then
		if UserInputService.MouseBehavior ~= Enum.MouseBehavior.LockCenter then
			UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
		end
		UserInputService.MouseIconEnabled = false
	else
		if UserInputService.MouseBehavior ~= Enum.MouseBehavior.Default then
			UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		end
		UserInputService.MouseIconEnabled = true
	end

	-- firing
	if firing and weapon then
		if weapon.auto then
			tryFire()
		end
	end

	-- crosshair bloom from weapon spread plus movement
	local moveFactor = 0
	if hum then
		moveFactor = math.min(1, hum.MoveDirection.Magnitude * (sprinting and 0.5 or 0.3))
	end
	movementSpread = math.max(0, movementSpread - dt * 1.6)
	local weaponSpread = weapon and math.min(1, weapon.spread / 8) or 0.2
	Hud.step(dt, hum, math.min(1.4, weaponSpread + moveFactor * 0.4 + movementSpread))
end)

RunService:BindToRenderStep("NecrotideCamera", Enum.RenderPriority.Camera.Value + 10, function(dt)
	Effects.stepCamera(dt)

	-- keep the body facing where the camera looks so the gun points forward
	local c = character()
	local hum = humanoid()
	local root = c and c:FindFirstChild("HumanoidRootPart")
	if not hum then return end

	local shouldSteer = root ~= nil and hum.Health > 0 and not downed and mouseLocked
	if hum.AutoRotate == shouldSteer then
		-- we steer the body by hand while locked, and hand it back when unlocked
		hum.AutoRotate = not shouldSteer
	end
	if shouldSteer then
		local look = camera.CFrame.LookVector
		local flat = Vector3.new(look.X, 0, look.Z)
		if flat.Magnitude > 0.01 then
			root.CFrame = CFrame.lookAt(root.Position, root.Position + flat.Unit)
		end
	end
end)

--------------------------------------------------------------------------------
-- initial state
--------------------------------------------------------------------------------

task.spawn(function()
	local ok, snapshot = pcall(function()
		return Net.get("RequestSnapshot"):InvokeServer()
	end)
	if not ok or not snapshot then return end
	Hud.setEconomy(snapshot.economy)
	Hud.setWave(snapshot.wave)
	Hud.setLoadout(snapshot.loadout)
	loadout = snapshot.loadout
	Hud.setBoss(snapshot.boss)
	if snapshot.player then
		Hud.setTonics(snapshot.player.tonics)
		Hud.setDowned(snapshot.player)
	end
	if snapshot.config then
		Hud.announce({
			title = snapshot.config.gameName,
			subtitle = snapshot.config.tagline,
			color = { 255, 206, 122 },
			duration = 4,
			big = true,
		})
	end
end)
]]></ProtectedString>
					<bool name="Disabled">false</bool>
				</Properties>
			</Item>
			<Item class="Folder" referent="RBX26">
				<Properties>
					<string name="Name">Modules</string>
				</Properties>
				<Item class="ModuleScript" referent="RBX24">
					<Properties>
						<string name="Name">Effects</string>
						<ProtectedString name="Source"><![CDATA[-- Effects: purely cosmetic client-side feedback - tracers, muzzle flash, chain
-- arcs, camera kick and the small sound kit. Uses only sounds that ship with the
-- Roblox client, so the place file has no external asset dependencies.

local Players = game:GetService("Players")
local Debris = game:GetService("Debris")
local TweenService = game:GetService("TweenService")
local SoundService = game:GetService("SoundService")

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local Effects = {}

local FX_FOLDER_NAME = "NecrotideClientFx"

local SOUNDS = {
	shot = "rbxasset://sounds/collide.mp3",
	click = "rbxasset://sounds/switch3.wav",
	impact = "rbxasset://sounds/bass.mp3",
	pickup = "rbxasset://sounds/electronicpingshort.wav",
	alarm = "rbxasset://sounds/action_falling.mp3",
}

local function fxFolder()
	local existing = camera:FindFirstChild(FX_FOLDER_NAME)
	if not existing then
		existing = Instance.new("Folder")
		existing.Name = FX_FOLDER_NAME
		existing.Parent = camera
	end
	return existing
end

function Effects.play(kind, volume, pitch)
	local asset = SOUNDS[kind]
	if not asset then return end
	local sound = Instance.new("Sound")
	sound.SoundId = asset
	sound.Volume = volume or 0.4
	sound.PlaybackSpeed = pitch or 1
	sound.Parent = SoundService
	sound:Play()
	Debris:AddItem(sound, 3)
end

local function muzzleOf(character)
	local gun = character and character:FindFirstChild("NecrotideGun")
	if not gun then return nil end
	local muzzle = gun:FindFirstChild("Muzzle")
	return muzzle and muzzle.Position or (gun.PrimaryPart and gun.PrimaryPart.Position)
end

local function drawBeam(from, to, color, thickness, life)
	local delta = to - from
	local distance = delta.Magnitude
	if distance < 0.5 then return end

	local beam = Instance.new("Part")
	beam.Name = "Tracer"
	beam.Anchored = true
	beam.CanCollide = false
	beam.CanQuery = false
	beam.CanTouch = false
	beam.Material = Enum.Material.Neon
	beam.Color = color
	beam.Size = Vector3.new(thickness, thickness, distance)
	beam.CFrame = CFrame.lookAt(from + delta * 0.5, to)
	beam.Transparency = 0.15
	beam.Parent = fxFolder()

	TweenService:Create(beam, TweenInfo.new(life or 0.09), {
		Transparency = 1,
		Size = Vector3.new(thickness * 0.2, thickness * 0.2, distance),
	}):Play()
	Debris:AddItem(beam, (life or 0.09) + 0.15)
end

local function impactPuff(position, color)
	local puff = Instance.new("Part")
	puff.Shape = Enum.PartType.Ball
	puff.Size = Vector3.new(0.6, 0.6, 0.6)
	puff.Position = position
	puff.Anchored = true
	puff.CanCollide = false
	puff.CanQuery = false
	puff.Material = Enum.Material.Neon
	puff.Color = color
	puff.Transparency = 0.2
	puff.Parent = fxFolder()
	TweenService:Create(puff, TweenInfo.new(0.22), { Size = Vector3.new(2.4, 2.4, 2.4), Transparency = 1 }):Play()
	Debris:AddItem(puff, 0.5)
end

function Effects.shot(data)
	if not data then return end
	local shooter = data.shooter
	local character = shooter and shooter.Character
	local origin = muzzleOf(character)
	if not origin then
		local root = character and character:FindFirstChild("HumanoidRootPart")
		origin = root and root.Position
	end
	if not origin then return end

	local color = data.color and Color3.fromRGB(data.color[1], data.color[2], data.color[3])
		or Color3.fromRGB(255, 222, 160)

	for _, point in ipairs(data.points or {}) do
		drawBeam(origin, point, color, data.upgraded and 0.28 or 0.18, 0.09)
		impactPuff(point, color)
	end

	if data.chain then
		local previous = (data.points and data.points[1]) or origin
		for _, linkPos in ipairs(data.chain) do
			drawBeam(previous, linkPos, color, 0.22, 0.18)
			previous = linkPos
		end
	end

	-- muzzle flash
	local flash = Instance.new("Part")
	flash.Shape = Enum.PartType.Ball
	flash.Size = Vector3.new(1.1, 1.1, 1.1)
	flash.Position = origin
	flash.Anchored = true
	flash.CanCollide = false
	flash.CanQuery = false
	flash.Material = Enum.Material.Neon
	flash.Color = color
	flash.Parent = fxFolder()
	local light = Instance.new("PointLight")
	light.Color = color
	light.Brightness = 6
	light.Range = 16
	light.Parent = flash
	TweenService:Create(flash, TweenInfo.new(0.08), { Size = Vector3.new(0.1, 0.1, 0.1), Transparency = 1 }):Play()
	Debris:AddItem(flash, 0.2)

	if shooter == player then
		Effects.play("shot", 0.35, 0.9 + math.random() * 0.25)
	elseif character then
		local root = character:FindFirstChild("HumanoidRootPart")
		local myRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if root and myRoot and (root.Position - myRoot.Position).Magnitude < 160 then
			Effects.play("shot", 0.14, 0.9 + math.random() * 0.25)
		end
	end
end

local kick = Vector2.new()

function Effects.addKick(amount)
	kick = kick + Vector2.new((math.random() - 0.5) * amount * 0.6, amount)
end

-- Applied by ClientMain every frame; decays back to zero.
function Effects.stepCamera(dt)
	if kick.Magnitude < 0.0001 then return end
	local applied = kick * math.min(1, dt * 12)
	camera.CFrame = camera.CFrame * CFrame.Angles(math.rad(applied.Y), math.rad(applied.X), 0)
	kick = kick * math.max(0, 1 - dt * 9)
end

return Effects
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX25">
					<Properties>
						<string name="Name">Hud</string>
						<ProtectedString name="Source"><![CDATA[-- Hud: builds the entire interface in code and exposes small update functions.
-- Nothing here talks to the server directly; ClientMain feeds it.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("NecrotideShared")
local TonicDefs = require(Shared.TonicDefs)
local Util = require(Shared.Util)

local player = Players.LocalPlayer

local Hud = {}

local FONT = Enum.Font.GothamBlack
local FONT_BODY = Enum.Font.GothamSemibold
local INK = Color3.fromRGB(240, 238, 245)
local PANEL = Color3.fromRGB(14, 13, 17)
local GOLD = Color3.fromRGB(255, 206, 122)

local ui = {}
local state = {
	crosshairSpread = 0,
	bleedRemaining = 0,
	downed = false,
	waveEndsAt = 0,
	wavePhase = "lobby",
	toasts = {},
}

local function corner(parent, radius)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius or 6)
	c.Parent = parent
	return c
end

local function stroke(parent, color, thickness, transparency)
	local s = Instance.new("UIStroke")
	s.Color = color or Color3.fromRGB(70, 66, 78)
	s.Thickness = thickness or 1
	s.Transparency = transparency or 0.2
	s.Parent = parent
	return s
end

local function frame(props)
	local f = Instance.new("Frame")
	f.BackgroundColor3 = props.color or PANEL
	f.BackgroundTransparency = props.transparency or 0.25
	f.BorderSizePixel = 0
	f.Size = props.size
	f.Position = props.position
	f.AnchorPoint = props.anchor or Vector2.new(0, 0)
	f.Name = props.name or "Frame"
	f.Visible = props.visible ~= false
	f.ZIndex = props.z or 1
	f.Parent = props.parent
	if props.round ~= false then
		corner(f, props.radius or 8)
	end
	return f
end

local function label(props)
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Size = props.size or UDim2.fromScale(1, 1)
	l.Position = props.position or UDim2.fromScale(0, 0)
	l.AnchorPoint = props.anchor or Vector2.new(0, 0)
	l.Font = props.font or FONT_BODY
	l.Text = props.text or ""
	l.TextColor3 = props.color or INK
	l.TextTransparency = props.textTransparency or 0
	l.TextScaled = props.scaled ~= false
	l.TextXAlignment = props.align or Enum.TextXAlignment.Center
	l.TextYAlignment = props.valign or Enum.TextYAlignment.Center
	l.Name = props.name or "Label"
	l.ZIndex = props.z or 2
	l.TextStrokeTransparency = props.strokeTransparency or 0.6
	l.Parent = props.parent
	if props.textSize then
		l.TextScaled = false
		l.TextSize = props.textSize
	end
	return l
end

--------------------------------------------------------------------------------
-- construction
--------------------------------------------------------------------------------

function Hud.build()
	local playerGui = player:WaitForChild("PlayerGui")
	if playerGui:FindFirstChild("NecrotideHud") then
		-- a HUD already exists (can happen right after the drag-in installer runs)
		return nil
	end

