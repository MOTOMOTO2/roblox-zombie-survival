		},
		phases = {
			{ at = 0.6, speedMult = 1.15, damageMult = 1.1, announce = "THE HOWLER CALLS THE CHOIR" },
			{ at = 0.3, speedMult = 1.35, damageMult = 1.25, announce = "THE HOWLER SCREAMS" },
		},
	},
	{
		id = "stitcher",
		name = "The Stitcher",
		title = "THIRD VOICE, MAKER OF CRAWLERS",
		health = 28000,
		speed = 9.6,
		damage = 68,
		height = 10.5,
		width = 4.0,
		isBoss = true,
		salvage = 4500,
		colors = {
